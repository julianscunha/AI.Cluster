if [ -d /sys/firmware/efi ]; then FW=uefi; else FW="u-boot ou BIOS"; fi
echo "AI Cluster: este computador é \$A, firmware \$FW."
echo "AI Cluster: baixando a etapa de espera de $IP…"
curl -fsS http://$IP:$PORT/worker-linux-\$A.tar.gz -o "\$T/w.tgz"
echo "\$SUM  \$T/w.tgz" | sha256sum -c - >/dev/null || { echo "pacote corrompido ou adulterado" >&2; exit 1; }
tar -C "\$T" -xzf "\$T/w.tgz" ./aic-wait 2>/dev/null || { echo "o pacote desta versão não traz o aic-wait" >&2; exit 1; }
chmod 755 "\$T/aic-wait"
# Não instala nem apaga nada: mostra o resumo e a impressão digital e espera a aprovação no servidor.
AIC_INSTALL_OUT=/run/aic-install.json "\$T/aic-wait" http://$IP:$ENROLL_PORT
WAIT_SCRIPT
  fi
  # Para quem já é um AI Cluster OS e só quer mudar de controller (`aic worker change` no nó): endereço e
  # token, sob o código do convite como o /join.
  printf 'AI_CLUSTER_CONTROLLER=http://%s:%s
AI_CLUSTER_JOIN_TOKEN=%s
' "$IP" "$GRPC_PORT" "$JOIN" > "$WEB/node-$GCODE"
  cd "$WEB"
  # Servidor do convite: arquivos sem listagem de diretório (o código do gateway não pode ser
  # descoberto olhando a raiz) e POST /sign?name=<nó>, que assina o pedido de certificado do worker.
  HD=$(mktemp -d)
  cat > "$HD/invite.py" <<'PYSERVER'
import hmac, http.server, os, re, subprocess, sys, tempfile, threading

CA = os.environ["AIC_CA_DIR"]
CODE = os.environ["AIC_INVITE_CODE"]
SIGNED = os.environ["AIC_SIGNED_LOG"]
EVENTS = os.environ["AIC_EVENTS_LOG"]
TTL = int(os.environ["AIC_TTL"])
MAX_IP = 30       # chutes errados por IP de origem: passou disso, o IP fica travado até o convite acabar
MAX_TOTAL = 300   # teto global: passou disso, ninguém mais é atendido
WEB = os.getcwd()
LOCK = threading.Lock()  # o ca.srl é lido e regravado pelo openssl: um pedido por vez
done = set()      # nomes já assinados nesta janela
guesses = {}      # IP -> chutes errados
locked = set()
total_guesses = [0]


def guess(ip):
    with LOCK:
        total_guesses[0] += 1
        guesses[ip] = guesses.get(ip, 0) + 1
        if guesses[ip] >= MAX_IP and ip not in locked:
            locked.add(ip)
            with open(EVENTS, "a") as f:
                f.write("lock %s\n" % ip)  # o shell avisa o operador


def blocked(ip):
    with LOCK:
        return ip in locked or total_guesses[0] >= MAX_TOTAL


def served(path):
    # Só arquivo comum na raiz do convite conta como servido; o caminho já vem normalizado por translate_path
    # (%6A vira j, ./ e ../ saem), então /%6Aoin-X e /./join-X caem aqui como qualquer outro caminho.
    p = os.path.abspath(path)
    return os.path.dirname(p) == WEB and os.path.isfile(p)


class H(http.server.SimpleHTTPRequestHandler):
    timeout = 10  # cliente que anuncia corpo e não envia não segura a thread

    def gate(self):
        ip = self.client_address[0]
        if blocked(ip):
            self.send_error(429)
            return False
        if not served(self.translate_path(self.path)):
            guess(ip)  # tudo que não é um arquivo servido é chute, GET ou HEAD
            self.send_error(404)
            return False
        return True

    def do_GET(self):
        if self.gate():
            super().do_GET()

    def do_HEAD(self):
        if self.gate():
            super().do_HEAD()

    def list_directory(self, path):
        self.send_error(404)

    def do_POST(self):
        ip = self.client_address[0]
        m = re.fullmatch(r"/sign\?name=([A-Za-z0-9.-]{1,40})&code=([A-Za-z0-9]{1,64})", self.path)
        size = int(self.headers.get("Content-Length") or 0)
        if not m or not 0 < size <= 8192:
            return self.send_error(400)
        if blocked(ip):
            return self.send_error(429)
        if not hmac.compare_digest(m.group(2).upper(), CODE):  # sem o código do convite ninguém ganha certificado
            guess(ip)
            return self.send_error(403)
        name = m.group(1)
        with LOCK:
            if name in done:  # quem entra de novo com o mesmo nome precisa de outro convite
                return self.send_error(409)
            done.add(name)
        with tempfile.TemporaryDirectory() as d:
            csr, crt, ext = (os.path.join(d, n) for n in ("w.csr", "w.crt", "w.ext"))
            open(csr, "wb").write(self.rfile.read(size))
            with open(ext, "w") as f:
                f.write("subjectAltName=DNS:aic-worker-%s\nbasicConstraints=CA:FALSE\nextendedKeyUsage=serverAuth\n" % name)
            with LOCK:
                ok = subprocess.run(["openssl", "req", "-noout", "-verify", "-in", csr], capture_output=True).returncode == 0 and subprocess.run(
                    ["openssl", "x509", "-req", "-in", csr, "-CA", CA + "/ca.crt", "-CAkey", CA + "/ca.key",
                     "-CAcreateserial", "-out", crt, "-days", "825", "-extfile", ext],
                    capture_output=True).returncode == 0
            if not ok:
                with LOCK:
                    done.discard(name)
                return self.send_error(400)
            body = open(crt, "rb").read()
        with open(SIGNED, "a") as log:
            log.write(name + "\n")
        self.send_response(200)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


# O convite expira sozinho: se o shell morrer sem fechar nada, o servidor não fica de pé.
threading.Timer(TTL, os._exit, [0]).start()
http.server.ThreadingHTTPServer((sys.argv[1], int(sys.argv[2])), H).serve_forever()
PYSERVER
  : > "$HD/signed"; : > "$HD/events"
  # Dez segundos a mais que a janela: quem encerra é o laço abaixo; o temporizador do Python é a rede de segurança.
  AIC_CA_DIR="$CONF/pki" AIC_INVITE_CODE="$GCODE" AIC_SIGNED_LOG="$HD/signed" AIC_EVENTS_LOG="$HD/events" \
    AIC_TTL=$((MIN * 60 + 10)) python3 "$HD/invite.py" "$IP" "$PORT" >/dev/null 2>"$HD/py.log" &
  SRV=$!
  MSG_CLOSED=$(t "Convite encerrado." "Invitation closed.")
  # Qualquer saída (erro, Ctrl+C, fim do prazo) derruba o servidor e apaga o que ele servia. Se fechar a
  # porta de espera falhar, avisa: ela ficaria aberta.
  trap 'kill "$SRV" 2>/dev/null; rm -rf "$WEB" "$HD"; if ! /usr/local/bin/aic cluster install close >/dev/null 2>&1; then echo "$(t "AVISO: não consegui fechar a porta de espera ($ENROLL_PORT): rode sudo aic cluster install close" "WARNING: could not close the waiting port ($ENROLL_PORT): run sudo aic cluster install close")" >&2; fi' EXIT
  trap 'printf "\n  %s\n\n" "$MSG_CLOSED"; exit 0' INT TERM HUP
  sleep 1
  kill -0 "$SRV" 2>/dev/null || die "$(t "não consegui abrir a porta $PORT em $IP: $(tail -n 2 "$HD/py.log" | tr '\n' ' ')" "could not open port $PORT on $IP: $(tail -n 2 "$HD/py.log" | tr '\n' ' ')")"
  # Instalação com aprovação: a porta de espera existe desde a instalação do servidor (servidor mais
  # antigo: acrescenta e reinicia o controller uma vez) e só aceita aparelhos enquanto este convite vale.
  if ! grep -q '^AI_CLUSTER_ENROLL_ADDR=' "$CONF/controller.env"; then
    echo "AI_CLUSTER_ENROLL_ADDR=$IP:$ENROLL_PORT" >> "$CONF/controller.env"
    warn "$(t 'habilitei a porta de espera da instalação e reiniciei o controller (os workers voltam sozinhos)' 'enabled the installation waiting port and restarted the controller (the workers come back on their own)')"
    svc_start controller
    sleep 2
  fi
  /usr/local/bin/aic cluster install open --minutes "$MIN" >/dev/null 2>&1 \
    || warn "$(t 'não consegui abrir a porta de espera da instalação; o /wait não vai funcionar' 'could not open the installation waiting port; /wait will not work')"
  if [ "$LANG_AIC" = en ]; then
    box "Worker (any x86_64 or 32-bit ARM computer), run:" "" \
        "curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh" "" \
        "Gateway on another computer: sudo aic gateway install --server $IP:$PORT --code $GCODE" "" \
        "Install the AI Cluster OS (dedicated mode) on a computer that already has Linux:" "" \
        "curl -fsSL http://$IP:$PORT/wait | sudo sh" "" \
        "Valid for $MIN min. Linux with systemd and, on x86_64, libgomp1."
    printf '\n  %sWaiting for computers… (Ctrl+C ends the invitation)%s\n\n' "$D" "$Z"
  else
    box "Worker (qualquer computador x86_64 ou ARM de 32 bits), rode:" "" \
        "curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh" "" \
        "Gateway noutro computador: sudo aic gateway install --server $IP:$PORT --code $GCODE" "" \
        "Instalar o AI Cluster OS (modo dedicado) num computador que já tem Linux:" "" \
        "curl -fsSL http://$IP:$PORT/wait | sudo sh" "" \
        "Válido por $MIN min. Linux com systemd e, no x86_64, libgomp1."
    printf '\n  %sAguardando computadores… (Ctrl+C encerra o convite)%s\n\n' "$D" "$Z"
  fi
  END=$(( $(date +%s) + MIN * 60 )); SEEN=0; SEEN_EV=0; : > "$HD/seen-installs"
  while [ "$(date +%s)" -lt "$END" ]; do
    # O servidor do convite tem de estar vivo: se caiu (porta ocupada depois, erro do Python), o motivo vai junto.
    kill -0 "$SRV" 2>/dev/null || die "$(t "o convite parou: $(tail -n 3 "$HD/py.log" | tr '\n' ' ')" "the invitation stopped: $(tail -n 3 "$HD/py.log" | tr '\n' ' ')")"
    # Cada certificado que o convite assina aparece aqui: um nome que você não reconhece é um intruso.
    TOTAL_SIGNED=$(wc -l < "$HD/signed" | tr -d ' ')
    if [ "$TOTAL_SIGNED" -gt "$SEEN" ]; then
      tail -n +$((SEEN + 1)) "$HD/signed" | while read -r n; do
        printf '  %s•%s %s %s\n' "$C" "$Z" "$(t 'certificado do túnel emitido para' 'tunnel certificate issued for')" "$n"
      done
      SEEN=$TOTAL_SIGNED
    fi
    # IP que errou demais o código: o operador vê quem está tentando entrar.
    TOTAL_EV=$(wc -l < "$HD/events" | tr -d ' ')
    if [ "$TOTAL_EV" -gt "$SEEN_EV" ]; then
      tail -n +$((SEEN_EV + 1)) "$HD/events" | while read -r ev ip; do
        [ "$ev" = lock ] || continue
        printf '  %s!%s %s\n' "$Y" "$Z" "$(t "convite: $ip travado por chutes" "invitation: $ip locked out after wrong guesses")"
      done
      SEEN_EV=$TOTAL_EV
    fi
    # Aparelhos que pediram para instalar: o operador confere a impressão digital e escolhe o disco.
    /usr/local/bin/aic cluster install list 2>/dev/null | grep '^INSTALAÇÃO fingerprint=' | while read -r _ fp rest; do
      f=${fp#fingerprint=}
      grep -qx "$f" "$HD/seen-installs" && continue
      echo "$f" >> "$HD/seen-installs"
      info=$(echo "$rest" | sed 's/ cpu=.*//; s/^aguardando //')
      if [ "$LANG_AIC" = en ]; then
        printf '  %s•%s device %s wants to install (%s)\n    check the fingerprint on its screen and approve: aic cluster install approve %s --disk <disk>\n' "$C" "$Z" "$f" "$info" "$f"
      else
        printf '  %s•%s aparelho %s quer instalar (%s)\n    confira a impressão digital na tela dele e aprove: aic cluster install approve %s --disk <disco>\n' "$C" "$Z" "$f" "$info" "$f"
      fi
    done || true
    # Nós pendentes enquanto o convite está aberto são aprovados: foi o operador quem os convidou. Quem é
    # pendente vem da coluna CONFIANÇA (pelo cabeçalho, não pela posição nem pela palavra solta no nome).
    /usr/local/bin/aic cluster nodes 2>/dev/null | awk '/CONFIANÇA/ { for (i = 1; i <= NF; i++) if ($i == "CONFIANÇA") c = i; next } c && $c == "pendente" { print $1 }' \
      | while read -r n; do
          case "$n" in
            -*) warn "$(t "nó '$n' começa com '-' (o aprova não aceita): aprove à mão" "node '$n' starts with '-' (approve does not accept it): approve it by hand")"; continue ;;
          esac
          if /usr/local/bin/aic cluster node approve "$n" --trust-listed >/dev/null 2>&1; then
            printf '  %s✔%s %s %s\n' "$G" "$Z" "$n" "$(t 'entrou e foi aprovado' 'joined and was approved')"
          else
            warn "$(t "não consegui aprovar $n sozinho: aic cluster node approve $n --fingerprint <impressão>" "could not approve $n by itself: aic cluster node approve $n --fingerprint <fingerprint>")"
          fi
        done || true
    sleep 3
  done
  if [ "$LANG_AIC" = en ]; then
    printf '\n  Invitation expired. For another: sudo aic cluster invite\n\n'
  else
    printf '\n  Convite expirou. Para outro: sudo aic cluster invite\n\n'
  fi
}

# ---------- assinatura da release (ADR-025) ----------
# A release traz SHA256SUMS.sig: a assinatura Ed25519 do SHA256SUMS, feita com a chave de Linux comum. Quem
# confere é a chave pinada nesta instalação (/etc/ai-cluster/release.pub): nenhum hash da release é confiado
# antes disso. A chave só é gravada pelos comandos de instalação (pina_chave); a atualização nunca a busca
# de novo na origem. SIG_MOTIVO guarda por que a conferência falhou (uma frase, pronta para mostrar).
pina_chave() {
  need_root
  mkdir -p "$CONF"
  [ -f "$HERE/release.pub" ] || return 0
  install -m 644 "$HERE/release.pub" "$CONF/release.pub"
}
confere_assinatura() { # confere_assinatura <SHA256SUMS> <SHA256SUMS.sig, base64>
  SIG_MOTIVO=""
  # -rawin (Ed25519 bruta) só existe no OpenSSL 3; o Debian 12 traz o 3.
  if ! openssl version 2>/dev/null | grep -Eq '^OpenSSL (3|[4-9])'; then
    SIG_MOTIVO=$(t 'OpenSSL 3 ou mais novo é necessário para conferir a assinatura (apt install openssl)' 'OpenSSL 3 or newer is required to check the signature (apt install openssl)')
    return 1
  fi
  if [ ! -f "$CONF/release.pub" ]; then
    SIG_MOTIVO=$(t "esta instalação não tem a chave de release ($CONF/release.pub): ela é anterior à assinatura. Para migrar, rode de novo o install.sh desta versão (ele grava a chave) e depois aic update apply" "this installation has no release key ($CONF/release.pub): it predates signing. To migrate, run install.sh of this version again (it saves the key), then aic update apply")
    return 1
  fi
  if [ -s "$2" ]; then
    s=$(mktemp) || return 1
    if base64 -d < "$2" > "$s" 2>/dev/null && [ "$(wc -c < "$s" | tr -d ' ')" = 64 ] \
      && openssl pkeyutl -verify -pubin -inkey "$CONF/release.pub" -rawin -in "$1" -sigfile "$s" >/dev/null 2>&1; then
      rm -f "$s"; return 0
    fi
    rm -f "$s"
    SIG_MOTIVO=$(t 'a assinatura da release não confere com a chave desta instalação (adulterada ou de outra chave); nada foi trocado' 'the release signature does not match this installation key (tampered or another key); nothing was changed')
  else
    SIG_MOTIVO=$(t 'a release não tem assinatura (SHA256SUMS.sig); nada foi trocado' 'the release has no signature (SHA256SUMS.sig); nothing was changed')
  fi
  return 1
}

# O worker Linux pede a atualização (ADR-025). linux_check confere o pedido sem gravar nada (o worker o chama
# antes de drenar): a assinatura tem de cobrir o SHA256SUMS da URL e a versão dela tem de ser a pedida.
# Recebe os cinco argumentos do comando de atualização; na release Linux os dois hashes não valem.
linux_check() { # linux_check <versão> <URL> <SHA256> <SHA da imagem> <assinatura>
  [ $# -eq 5 ] || { echo "uso: aic-update-linux [--verify] <versão> <url> <sha256> <sha256-imagem> <assinatura>" >&2; return 3; }
  case "$1" in ''|*[!0-9A-Za-z.+-]*) echo "versão inválida" >&2; return 3 ;; esac
  case "$2" in http://*|https://*) ;; *) echo "url inválida" >&2; return 3 ;; esac
  case "$2" in *[!A-Za-z0-9._~:/%+-]*) echo "url com caracteres inválidos" >&2; return 3 ;; esac
  case "$5" in *[!A-Za-z0-9+/=]*) echo "assinatura inválida" >&2; return 3 ;; esac
  [ "${#5}" = 88 ] || { echo "assinatura inválida" >&2; return 3; }
  t_=$(mktemp -d) || return 3
  PROTO=""; case "$2" in https://*) PROTO="--proto =https --tlsv1.2" ;; esac
  if ! curl -fsSL $PROTO -o "$t_/SHA256SUMS" "$2/SHA256SUMS" || ! curl -fsSL $PROTO -o "$t_/VERSION" "$2/VERSION"; then
    rm -rf "$t_"; echo "não consegui ler a release em $2" >&2; return 3
  fi
  printf '%s' "$5" > "$t_/sig"
  if ! confere_assinatura "$t_/SHA256SUMS" "$t_/sig"; then rm -rf "$t_"; echo "$SIG_MOTIVO" >&2; return 3; fi
  want=$(awk '$2=="VERSION" {print $1}' "$t_/SHA256SUMS")
  if [ -z "$want" ] || [ "$want" != "$(sha256sum "$t_/VERSION" | cut -d' ' -f1)" ]; then
    rm -rf "$t_"; echo "o VERSION da release não confere com o SHA256SUMS assinado" >&2; return 3
  fi
  v_=$(cat "$t_/VERSION"); rm -rf "$t_"
  [ "$v_" = "$1" ] || { echo "a release assinada é a $v_, não a $1" >&2; return 3; }
}
# O worker chama com <versão> <URL> <SHA> <SHA da imagem> <assinatura> e o pedido vai para o ai-cluster-update.
linux_request() {
  linux_check "$@" || return 3
  printf '%s %s %s\n' "$1" "$2" "$5" > "$PREFIX/state/update-request.tmp" \
    && mv -f "$PREFIX/state/update-request.tmp" "$PREFIX/state/update-request"
}
# ai-cluster-update (root, por caminho): lê o pedido, confere de novo e aplica como `update apply`. Um motivo de
# recusa ou uma atualização desfeita vai para update-result, que o worker mostra e não repete.
# Origem de uma URL: esquema e host (sem o caminho). O caminho pode ser latest/download ou vX.
origem_de() { case "$1" in http://*|https://*) r=${1#*://}; printf '%s://%s' "${1%%://*}" "${r%%/*}" ;; esac; }
# O state é do worker (dono ai-cluster): o root nunca segue um link nele. O resultado é criado com O_EXCL
# (set -C), que não segue link; antes, o link antigo é removido.
grava_resultado() { rm -f "$R"; ( set -C; printf '%s\n' "$1" > "$R" ) 2>/dev/null || true; }
linux_apply() {
  need_root
  P="$PREFIX/state/update-request"; R="$PREFIX/state/update-result"
  if [ -L "$P" ]; then rm -f "$P"; grava_resultado "pedido de atualização é um link simbólico: recusado"; return 1; fi
  [ -f "$P" ] || return 0
  read -r LV LURL LSIG < "$P" || true
  rm -f "$P" "$R"
  if ! motivo=$(linux_check "$LV" "$LURL" "" "" "$LSIG" 2>&1); then
    grava_resultado "$motivo"; return 1
  fi
  # O pedido só fala com a origem desta instalação (esquema e host de /etc/ai-cluster/release), nunca com outro host.
  BASE_ATUAL=$(get "$CONF/release" BASE)
  if [ -z "$BASE_ATUAL" ] || [ "$(origem_de "$LURL")" != "$(origem_de "$BASE_ATUAL")" ]; then
    grava_resultado "$(t "a URL do pedido ($LURL) não é da origem desta instalação (${BASE_ATUAL:-vazia}): recusado" "the request URL ($LURL) is not from this installation's origin (${BASE_ATUAL:-empty}): refused")"
    return 1
  fi
  if ! ( AIC_UPDATE_BASE=$LURL cmd_update apply --yes ) >>"$SETUP_LOG" 2>&1; then
    grava_resultado "$(t "a atualização para $LV não concluiu (veja $SETUP_LOG)" "the update to $LV did not finish (see $SETUP_LOG)")"
    return 1
  fi
}
# Gatilho do worker Linux: o comando de atualização vai ao worker.env e, com systemd, o ai-cluster-update (root)
# passa a rodar quando aparece um pedido. Sem systemd não há quem aplique: a atualização fica manual.
gatilho_linux() {
  [ -f "$PREFIX/worker.env" ] || return 0
  # Sem systemd não há quem aplique o pedido: o nó não se declara atualizável, então o rollout não o escolhe.
  if ! have_systemd; then
    echo "AVISO: sem systemd o worker não recebe atualização do controller; atualize com aic update apply"
    return 0
  fi
  ensure_env "$PREFIX/worker.env" AI_CLUSTER_UPDATE_CMD "$PREFIX/bin/aic-update-linux" || return 1
  ensure_env "$PREFIX/worker.env" AI_CLUSTER_UPDATE_KIND linux || return 1
  ensure_env "$PREFIX/worker.env" AI_CLUSTER_UPDATE_MARK "$PREFIX/state/update-tried" || return 1
  cat > /etc/systemd/system/ai-cluster-update.path <<UNIT
[Unit]
Description=AI Cluster: aplica a atualização que o worker pediu

[Path]
PathExists=$PREFIX/state/update-request
Unit=ai-cluster-update.service

[Install]
WantedBy=multi-user.target
UNIT
  cat > /etc/systemd/system/ai-cluster-update.service <<UNIT
[Unit]
Description=AI Cluster: atualização pedida pelo worker

[Service]
Type=oneshot
ExecStart=$PREFIX/libexec/setup update linux-apply
UNIT
  systemctl daemon-reload && systemctl enable --now ai-cluster-update.path >/dev/null 2>&1
}

# ---------- atualização ----------
# Acrescenta KEY=VALOR a um arquivo de ambiente se a chave ainda não existe (config nova de uma versão nova).
# O arquivo tem de existir; sem a quebra de linha final, a chave nova iria parar na linha do último valor.
ensure_env() { # ensure_env <arquivo> <CHAVE> <VALOR>
  [ -f "$1" ] || return 1
  grep -q "^$2=" "$1" && return 0
  if [ -n "$(tail -c 1 "$1")" ]; then printf '\n' >> "$1"; fi
  printf '%s=%s\n' "$2" "$3" >> "$1"
}

# Onde cada binário da release vai parar neste computador.
dest_de() {
  case "$1" in ggml-rpc-server) echo /usr/local/bin/ggml-rpc-server ;; *) echo "$PREFIX/bin/$1" ;; esac
}

# guarda <arquivo> <nome no snapshot>: copia o arquivo atual antes da troca. Se ele não existia, vai para a
# lista de novos (desfazer o remove).
guarda() {
  if [ -e "$1" ]; then cp -p "$1" "$SNAP/$2" && printf '%s %s\n' "$2" "$1" >> "$SNAP/manifesto"
  else printf '%s\n' "$1" >> "$SNAP/novos"; fi
}

# Devolve o que o snapshot guardou (cada arquivo por rename) e remove o que não existia antes.
restaura() {
  falhas=0
  while read -r n d; do
    [ -n "$n" ] || continue
    cp -p "$SNAP/$n" "$d.volta" 2>/dev/null && mv -f "$d.volta" "$d" 2>/dev/null || falhas=$((falhas + 1))
  done < "$SNAP/manifesto"
  while read -r d; do
    [ -n "$d" ] || continue
    rm -f "$d" 2>/dev/null || falhas=$((falhas + 1))
  done < "$SNAP/novos"
  [ "$falhas" = 0 ]
}

# Troca os programas e a configuração e reinicia. Qualquer falha aqui vira desfazer_atualizacao.
aplica_nova() {
  for b in $BINS; do [ ! -f "$U/new/$b" ] || troca "$U/new/$b" "$(dest_de "$b")" || return 1; done
  if [ -f "$U/new/setup" ]; then mkdir -p "$PREFIX/libexec" && troca "$U/new/setup" "$PREFIX/libexec/setup" || return 1; fi
  if [ -f "$U/new/bootstrap.sh" ]; then troca "$U/new/bootstrap.sh" "$PREFIX/bootstrap.sh" || return 1; fi
  instala_comando || return 1
  # Configuração que versões novas passaram a esperar: só entra o que ainda não existe.
  if [ "$ROLE" = both ] || [ "$ROLE" = controller ]; then
    if [ -f "$CONF/server-ip" ]; then ensure_env "$CONF/controller.env" AI_CLUSTER_ENROLL_ADDR "$(cat "$CONF/server-ip"):$ENROLL_PORT" || return 1; fi
  fi
  if [ "$ROLE" = both ] || [ "$ROLE" = gateway ]; then
    # Gateway sozinho não tem server-ip: o endereço do gateway é o da rede deste computador.
    if [ "$ROLE" = both ]; then gw_ip=$(cat "$CONF/server-ip" 2>/dev/null || true); else gw_ip=$(lan_ip); fi
    if [ -n "$gw_ip" ]; then ensure_env "$CONF/gateway.env" AI_CLUSTER_GATEWAY_URL "http://$gw_ip:$HTTP_PORT" || return 1; fi
  fi
  # O worker Linux ganha o gatilho (e a chave de pedido) antes de reiniciar, para o novo ambiente já valer.
  if [ "$ROLE" = worker ]; then gatilho_linux || return 1; fi
  reinicia_e_espera || return 1
  retira_nomes_antigos
}

# Volta tudo o que a atualização trocou (programas, configuração e o próprio instalador) e reinicia com a
# versão anterior. Se a anterior também não subir, diz isso à parte. Sempre termina com erro.
desfaz_update() {
  warn "$(t 'a versão nova não subiu; voltando para a anterior' 'the new version did not start; going back to the previous one')"
  restaura >>"$SETUP_LOG" 2>&1 || warn "$(t 'não consegui restaurar todos os arquivos (veja o log)' 'could not restore every file (see the log)')"
  if reinicia_e_espera >>"$SETUP_LOG" 2>&1; then
    rm -rf "$SNAP"
    die "$(t "atualização desfeita: a versão anterior voltou a rodar (log em $SETUP_LOG)" "update rolled back: the previous version is running again (log in $SETUP_LOG)")"
  fi
  rm -rf "$SNAP"
  die "$(t "atualização desfeita, mas a versão anterior também não subiu (log em $SETUP_LOG)" "update rolled back, but the previous version did not start either (log in $SETUP_LOG)")"
}

# `update status` (só consulta a origem) e `update apply` (instala). Vale para controller, gateway e worker.
cmd_update() {
  ACAO=${1:-}; [ $# -eq 0 ] || shift
  case "$ACAO" in status|apply) ;; *) usage ;; esac
  FORCE=0; YES=0; WANT=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) FORCE=1; shift ;;
      --yes|-y) YES=1; shift ;;
      --version) [ $# -ge 2 ] || die "$(t '--version pede um valor' '--version needs a value')"; WANT=$2; shift 2 ;;
      --lang) [ $# -ge 2 ] || die "$(t '--lang pede um valor' '--lang needs a value')"; set_lang "$2"; shift 2 ;;
      *) die "$(t "argumento desconhecido: $1" "unknown argument: $1")" ;;
    esac
  done
  need_root
  [ -f "$CONF/.installed" ] || die "$(t 'nada instalado aqui: use o install.sh' 'nothing installed here: use install.sh')"
  ROLE=$(get "$CONF/release" ROLE); [ -n "$ROLE" ] || ROLE=both
  case "$ROLE" in both|controller|gateway|worker) ;; *) die "$(t "papel desconhecido em $CONF/release: $ROLE" "unknown role in $CONF/release: $ROLE")" ;; esac
  BASE=$(get "$CONF/release" BASE)
  if [ -n "${AIC_UPDATE_BASE:-}" ]; then BASE=$AIC_UPDATE_BASE   # o worker Linux aplica da URL do pedido (ADR-025)
  elif [ -n "$WANT" ]; then
    case "$WANT" in ''|*[!0-9A-Za-z.+-]*) die "$(t '--version aceita só letras, dígitos e . + -' '--version accepts only letters, digits and . + -')" ;; esac
    BASE="https://github.com/julianscunha/Real.AI.Cluster/releases/download/v$WANT"
  fi
  # Sem origem não há de onde baixar: nada de chutar o último lançamento do GitHub.
  [ -n "$BASE" ] || die "$(t 'a instalação não guardou de onde baixar a atualização; rode sudo aic update apply --version X.Y.Z' 'the installation did not keep where to download the update from; run sudo aic update apply --version X.Y.Z')"
  case "$(uname -m)" in
    x86_64) A=x86_64 ;; armv7l|armv7) A=armv7 ;;
    *) die "$(t "processador sem pacote: $(uname -m)" "no package for this processor: $(uname -m)")" ;;
  esac
  PROTO=""; case "$BASE" in https://*) PROTO="--proto =https --tlsv1.2" ;; esac
  banner atualização "$(versao)" "$(t 'Atualização' 'Update')"
  U=$(mktemp -d); trap 'rm -rf "$U"' EXIT
  curl -fsSL $PROTO -o "$U/SHA256SUMS" "$BASE/SHA256SUMS" \
    || die "$(t "não consegui ler a release em $BASE" "could not read the release at $BASE")"
  # A assinatura vem antes de qualquer hash da release (ADR-025): sem ela, ou com outra chave, nada é trocado.
  curl -fsSL $PROTO -o "$U/SHA256SUMS.sig" "$BASE/SHA256SUMS.sig" 2>/dev/null || : > "$U/SHA256SUMS.sig"
  confere_assinatura "$U/SHA256SUMS" "$U/SHA256SUMS.sig" || die "$SIG_MOTIVO"
  curl -fsSL $PROTO -o "$U/VERSION" "$BASE/VERSION" \
    || die "$(t "não consegui ler a release em $BASE" "could not read the release at $BASE")"
  want=$(awk '$2=="VERSION" {print $1}' "$U/SHA256SUMS")
  [ -n "$want" ] && [ "$want" = "$(sha256sum "$U/VERSION" | cut -d' ' -f1)" ] \
    || die "$(t 'VERSION não confere com o SHA256SUMS assinado' 'VERSION does not match the signed SHA256SUMS')"
  NEWV=$(cat "$U/VERSION"); OLDV=$(get "$CONF/release" VERSION)
  # A versão vai para o arquivo de release e para a tela: só letras, dígitos e . + - (sem quebra nem caractere de sed).
  case "$NEWV" in ''|*[!0-9A-Za-z.+-]*) die "$(t 'a release traz uma versão inválida' 'the release has an invalid version')" ;; esac
  NEWSUM=$(sha256sum "$U/SHA256SUMS" | cut -d' ' -f1)
  if [ "$ACAO" = status ]; then
    if [ "$NEWSUM" = "$(get "$CONF/release" SUMS)" ]; then
      printf '  %s✔%s %s\n\n' "$G" "$Z" "$(t "já está na versão mais recente (${NEWV})" "already on the latest version (${NEWV})")"
    else
      note "$(t "Versão instalada: ${OLDV:-?}  ->  disponível: $NEWV" "Installed version: ${OLDV:-?}  ->  available: $NEWV")"
      note "$(t 'Para atualizar: sudo aic update apply' 'To update: sudo aic update apply')"
      printf '\n'
    fi
    return 0
  fi
  if [ "$FORCE" != 1 ] && [ "$NEWSUM" = "$(get "$CONF/release" SUMS)" ]; then
    printf '  %s✔%s %s\n\n' "$G" "$Z" "$(t "já está na versão mais recente (${NEWV})" "already on the latest version (${NEWV})")"
    return 0
  fi
  # Versão mais antiga só com --force: o pedido do controller nunca faz voltar a versão sem o operador pedir.
  if [ "$FORCE" != 1 ] && [ -n "$OLDV" ] && [ "$NEWV" != "$OLDV" ] \
    && [ "$(printf '%s\n%s\n' "$OLDV" "$NEWV" | sort -V | head -n 1)" = "$NEWV" ]; then
    die "$(t "a release $NEWV é mais antiga que a instalada ($OLDV); use --force para voltar" "release $NEWV is older than the installed one ($OLDV); use --force to go back")"
  fi
  note "$(t "Versão instalada: ${OLDV:-?}  ->  disponível: $NEWV" "Installed version: ${OLDV:-?}  ->  available: $NEWV")"
  case "$ROLE" in
    both) NEED="tools controller-linux-$A gateway-linux-$A"; SERVICES="controller gateway"; BINS="$BINS_SERVIDOR" ;;
    controller) NEED="tools controller-linux-$A"; SERVICES="controller"; BINS="ai-cluster-controller aic" ;;
    gateway) NEED="tools gateway-linux-$A"; SERVICES="gateway"; BINS="ai-cluster-gateway llama-server aic" ;;
    worker) NEED="worker-linux-$A"; SERVICES=""; BINS="ai-cluster-worker ggml-rpc-server aic aic-update-linux" ;;
  esac
  if [ "$YES" != 1 ] && [ -t 0 ]; then
    if [ "$LANG_AIC" = en ]; then
      printf '  Update now? Workers, tokens and certificates stay. [Y/n] '; read -r a || a=n
      case "$a" in n|N|no|No|NO) die "cancelled" ;; esac
    else
      printf '  Atualizar agora? Workers, tokens e certificados continuam. [S/n] '; read -r a || a=n
      case "$a" in n|N|nao|não) die "cancelado" ;; esac
    fi
  fi
  mkdir -p "$U/new"
  for f in $NEED; do
    curl -fL $PROTO --progress-bar -o "$U/$f.tar.gz" "$BASE/$f.tar.gz" || die "$(t "não consegui baixar $f" "could not download $f")"
    want=$(awk -v f="$f.tar.gz" '$2==f {print $1}' "$U/SHA256SUMS")
    [ -n "$want" ] && [ "$want" = "$(sha256sum "$U/$f.tar.gz" | cut -d' ' -f1)" ] \
      || die "$(t "$f não confere com o SHA256SUMS (corrompido ou adulterado)" "$f does not match SHA256SUMS (corrupted or tampered)")"
    tar -C "$U/new" -xzf "$U/$f.tar.gz"
    printf '  %s✔%s %s\n' "$G" "$Z" "$f"
  done
  # Tudo baixado e conferido. Antes de trocar, guarda o que vai mudar: se algo falhar depois, volta.
  # Os binários ficam em .prev (a geração anterior) só depois que a nova subiu: o .prev.novo é provisório.
  PREV="$PREFIX/bin/.prev"
  SNAP="$PREFIX/bin/.prev.novo"; rm -rf "$SNAP"; mkdir -p "$SNAP"; : > "$SNAP/manifesto"; : > "$SNAP/novos"
  for b in $BINS; do guarda "$(dest_de "$b")" "$b"; done
  guarda "$PREFIX/libexec/setup" setup
  guarda "$PREFIX/bootstrap.sh" bootstrap.sh
  guarda /usr/local/bin/aic aic-wrapper
  guarda "$CONF/release" release
  case "$ROLE" in both|controller) guarda "$CONF/controller.env" controller.env ;; esac
  case "$ROLE" in both|gateway) guarda "$CONF/gateway.env" gateway.env ;; esac
  [ "$ROLE" != worker ] || guarda "$PREFIX/worker.env" worker.env
  : > "$SETUP_LOG"; chmod 600 "$SETUP_LOG"
  TOTAL=1
  if ! passo "$(t 'Trocando os programas e reiniciando' 'Swapping the programs and restarting')" aplica_nova; then
    desfaz_update
  fi
  # A nova subiu: agora a geração anterior vira o .prev e a release nova é gravada.
  rm -rf "$PREV"; mv "$SNAP" "$PREV"
  if grep -q '^VERSION=' "$CONF/release"; then sed -i "s|^VERSION=.*|VERSION=$NEWV|" "$CONF/release"
  else echo "VERSION=$NEWV" >> "$CONF/release"; fi
  sed -i '/^SUMS=/d' "$CONF/release"
  echo "SUMS=$NEWSUM" >> "$CONF/release"
  avisa_pendencias
  printf '\n'
  if [ "$LANG_AIC" = en ]; then
    box "Updated to $NEWV" "" \
        "Workers, tokens and certificates were kept." \
        "Workers reconnect on their own in a few seconds." \
        "A new invitation downloads the new worker package." \
        "Previous binaries: $PREV"
  else
    box "Atualizado para $NEWV" "" \
        "Workers, tokens e certificados continuam como estavam." \
        "Os workers se reconectam sozinhos em alguns segundos." \
        "Um novo convite baixa o pacote novo do worker." \
        "Binários anteriores: $PREV"
  fi
  printf '\n'
}

# ---------- despacho: <substantivo> <verbo> ----------
sub_controller() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    install) pina_chave; cmd_controller_install "$@" ;;
    status) need_root; mostra_estado controller ai-cluster-controller "$DATA/state/controller.pid" "$GRPC_PORT" "$ENROLL_PORT" ;;
    logs) need_root; mostra_logs ai-cluster-controller "$LOGDIR/controller.log" "$@" ;;
    *) usage ;;
  esac
}

sub_gateway() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    install) pina_chave; cmd_gateway_install "$@" ;;
    status) need_root; mostra_estado gateway ai-cluster-gateway "$DATA/state/gateway.pid" "$HTTP_PORT" ;;
    logs) need_root; mostra_logs ai-cluster-gateway "$LOGDIR/gateway.log" "$@" ;;
    *) usage ;;
  esac
}

sub_worker() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    join) pina_chave; cmd_worker_join "$@" ;;
    status) need_root; mostra_estado worker ai-cluster-worker "$PREFIX/state/worker.pid" ;;
    logs) need_root; mostra_logs ai-cluster-worker "$PREFIX/state/worker.log" "$@" ;;
    role|change|passwd) worker_so ;;
    *) usage ;;
  esac
}

sub_cluster() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    invite) cmd_invite "$@" ;;
    *) usage ;;
  esac
}

case "${1:-}" in
  controller) shift; sub_controller "$@" ;;
  gateway) shift; sub_gateway "$@" ;;
  worker) shift; sub_worker "$@" ;;
  cluster) shift; sub_cluster "$@" ;;
  update) shift
    case "${1:-}" in
      # Internos (ADR-025): o aic-update-linux (sem root) confere e pede; o ai-cluster-update (root) aplica.
      linux-check) shift; linux_check "$@" ;;   # versão, URL, SHA, SHA da imagem, assinatura
      linux-request) shift; linux_request "$@" ;;
      linux-apply) linux_apply ;;
      linux-trigger) need_root; gatilho_linux ;;
      *) cmd_update "$@" ;;
    esac ;;
  *) usage ;;
esac
