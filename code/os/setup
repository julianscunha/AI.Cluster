#!/bin/sh
# AI Cluster — motor de instalação e administração deste Linux (ADR-024). Quem o chama é o `aic` (o
# binário Rust repassa a linha: `<libexec>/setup <substantivo> <verbo> [args…]`) ou o install.sh.
# Também roda direto, com o pacote ao lado:
#
#   sudo ./setup controller install [--with-gateway] [--ip IP] [--models-dir DIR] [--yes] [--lang pt|en]
#   sudo ./setup controller status | logs [-f] [-n N]
#   sudo ./setup gateway install --server IP[:8099] --code CÓDIGO [--models-dir DIR] [--yes] [--lang pt|en]
#   sudo ./setup gateway status | logs [-f] [-n N]
#   sudo ./setup worker join --server IP[:8099] --code CÓDIGO [--yes] [--lang pt|en]
#   sudo ./setup worker status | logs [-f] [-n N]
#   sudo ./setup worker role | change | passwd     só no AI Cluster OS (aqui responde que não existe)
#   sudo ./setup cluster invite [--minutes 15] [--port 8099]
#   sudo ./setup update status | apply [--version X.Y.Z] [--force] [--yes] [--lang pt|en]
#
# `controller install` instala o controller neste Linux (com --with-gateway, o gateway também), gera
# tokens, a CA do túnel RPC e os certificados, e deixa o `aic` pronto. Sem systemd, os serviços sobem em
# segundo plano e não voltam sozinhos depois de um reinício. `cluster invite` abre uma janela em que outros
# computadores entram no cluster:
#     curl -fsSL http://<ip>:8099/join-<código> | sudo sh     # worker (x86_64 ou armv7); o código está no convite
# e aprova sozinho os nós que entram enquanto o convite está aberto. O pacote do worker de cada
# processador vem da release do servidor (a mesma versão do cluster) e fica em cache.
#
# Ao lado deste script: ai-cluster-controller, ai-cluster-gateway, llama-server, aic e bootstrap.sh (o que o
# papel pedir). O worker e o ggml-rpc-server não vêm: o convite os busca.
# Idioma: AIC_LANG=pt|en (o install.sh o exporta) ou --lang; sem nenhum, vale o salvo na instalação (/etc/ai-cluster/lang).
set -eu

PREFIX=/opt/ai-cluster
CONF=/etc/ai-cluster
DATA=/var/lib/ai-cluster
LOGDIR=/var/log/ai-cluster
SETUP_LOG=/var/log/ai-cluster-setup.log
GRPC_PORT=50051
ENROLL_PORT=50052   # a porta de espera da instalação (ADR-023): fechada até o convite abri-la
HTTP_PORT=8080
HERE=$(cd "$(dirname "$0")" && pwd)
BINS_SERVIDOR="ai-cluster-controller ai-cluster-gateway aic llama-server"

# Idioma: AIC_LANG (o install.sh o exporta); sem ele, o salvo na instalação deste computador.
if [ -z "${AIC_LANG:-}" ] && [ -f "$CONF/lang" ]; then AIC_LANG=$(head -n 1 "$CONF/lang"); fi
LANG_AIC=${AIC_LANG:-pt}
case "$LANG_AIC" in pt|en) ;; *) echo "AIC_LANG deve ser pt ou en (recebido: $LANG_AIC) / AIC_LANG must be pt or en (got: $LANG_AIC)" >&2; exit 2 ;; esac
# t <pt> <en>: a frase no idioma escolhido.
t() { if [ "$LANG_AIC" = en ]; then printf '%s' "$2"; else printf '%s' "$1"; fi; }
set_lang() { case "$1" in pt|en) LANG_AIC=$1 ;; *) die "$(t '--lang deve ser pt ou en' '--lang must be pt or en')" ;; esac; }

# ---------- apresentação ----------
# Cores do brand::banner (crates/common/src/brand.rs): título em branco negrito, linhas do logotipo em
# ciano, apoio em cinza. Só num terminal que aceita cor.
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${TERM:-}" != dumb ]; then
  B=$(printf '\033[1m'); W=$(printf '\033[1;97m'); D=$(printf '\033[2;37m'); G=$(printf '\033[32m')
  R=$(printf '\033[31m'); C=$(printf '\033[36m'); Y=$(printf '\033[33m'); Z=$(printf '\033[0m'); TTY=1
else
  B=""; W=""; D=""; G=""; R=""; C=""; Y=""; Z=""; TTY=0
fi

# Cabeçalho igual ao do Rust: logotipo de 5 linhas (malha de 7 nós), nome do componente, apoio, versão e
# detalhe. Sem terminal (ou com NO_COLOR) vira uma linha só, como o brand::banner.
banner() { # banner <componente> <versão, ou vazio> <detalhe>
  if [ "$TTY" != 1 ]; then printf 'Real.AI.Cluster %s%s - %s\n' "$1" "${2:+ v$2}" "$3"; return; fi
  printf '\n   %s■%s───%s■%s\n' "$W" "$C" "$W" "$Z"
  printf '  %s/ \\ / \\%s     %sReal.AI.Cluster %s%s\n' "$C" "$Z" "$W" "$1" "$Z"
  printf ' %s■%s───%s■%s───%s■%s    %sIA distribuida em hardware comum%s\n' "$W" "$C" "$W" "$C" "$W" "$Z" "$D" "$Z"
  if [ -n "$2" ]; then printf '  %s\\ / \\ /%s     %sversao %s%s\n' "$C" "$Z" "$D" "$2" "$Z"
  else printf '  %s\\ / \\ /%s\n' "$C" "$Z"; fi
  printf '   %s■%s───%s■%s      %s%s%s\n\n' "$W" "$C" "$W" "$Z" "$C" "$3" "$Z"
}
die() { printf '\n  %s✘ %s%s\n\n' "$R" "$1" "$Z" >&2; exit 1; }
note() { printf '  %s%s%s\n' "$D" "$1" "$Z"; }
warn() { printf '  %s! %s%s\n' "$Y" "$1" "$Z"; }
usage() {
  echo "$(t 'uso: setup controller install|status|logs | gateway install|status|logs | worker join|status|logs | cluster invite | update status|apply  (veja o cabeçalho do script)' 'usage: setup controller install|status|logs | gateway install|status|logs | worker join|status|logs | cluster invite | update status|apply  (see the script header)')" >&2
  exit 2
}

TOTAL=0; N=0
# Roda uma função mostrando "n/total descrição"; a saída vai ao log, e o fim dele aparece se falhar.
step() {
  N=$((N + 1)); desc=$1; shift
  if [ "$TTY" = 1 ]; then printf '  %s[%d/%d]%s %s…' "$D" "$N" "$TOTAL" "$Z" "$desc"; fi
  # Subshell com set -e: dentro de `if` o set -e seria ignorado e só o último comando contaria.
  set +e; ( set -e; "$@" ) >>"$SETUP_LOG" 2>&1; rc=$?; set -e
  if [ "$rc" = 0 ]; then
    if [ "$TTY" = 1 ]; then printf '\r\033[K'; fi
    printf '  %s✔%s %s%s%s\n' "$G" "$Z" "$desc" "$D" "" ; printf '%s' "$Z"
  else
    if [ "$TTY" = 1 ]; then printf '\r\033[K'; fi
    printf '  %s✘ %s%s\n' "$R" "$desc" "$Z"
    tail -n 12 "$SETUP_LOG" | sed 's/^/      /' >&2
    die "$(t "falhou (log completo em $SETUP_LOG)" "failed (full log in $SETUP_LOG)")"
  fi
}

# Largura em caracteres (não em bytes): descarta os bytes de continuação do UTF-8.
clen() { printf '%s' "$1" | LC_ALL=C sed 's/[-¿]//g' | wc -c | tr -d ' '; }
box() { # box linha...
  w=0
  for l in "$@"; do n=$(clen "$l"); [ "$n" -gt "$w" ] && w=$n; done
  line=$(printf '%*s' $((w + 2)) '' | sed 's/ /─/g')
  printf '  %s┌%s┐%s
' "$C" "$line" "$Z"
  for l in "$@"; do
    pad=$(printf '%*s' $((w - $(clen "$l"))) '')
    printf '  %s│%s %s%s %s│%s
' "$C" "$Z" "$l" "$pad" "$C" "$Z"
  done
  printf '  %s└%s┘%s
' "$C" "$line" "$Z"
}

# ---------- utilidades ----------
rand() { head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
have_systemd() { [ -d /run/systemd/system ]; }
need_root() { [ "$(id -u)" = 0 ] || die "$(t 'rode como root (sudo)' 'run as root (sudo)')"; }
lan_ip() {
  ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1
}
get() { sed -n "s/^$2=//p" "$1" | head -n 1; }   # get <arquivo> <CHAVE>
# A versão instalada: a da release gravada; no instalador, a que ele acabou de baixar.
versao() { v=${AIC_RELEASE_VERSION:-}; [ -n "$v" ] || v=$(get "$CONF/release" VERSION 2>/dev/null); printf '%s' "$v"; }
# Serviço rodando agora: systemd, ou o pid guardado quando sobe em segundo plano.
ativo() { # ativo <serviço> <arquivo-do-pid>
  if have_systemd; then systemctl is-active --quiet "$1"
  else p=$(cat "$2" 2>/dev/null) && [ -n "$p" ] && kill -0 "$p" 2>/dev/null; fi
}
# Troca um binário por rename: o arquivo que está rodando não é alterado no lugar.
troca() { install -m 755 "$1" "$2.new" && mv -f "$2.new" "$2"; }
sem_systemd_aviso() {
  have_systemd || warn "$(t 'sem systemd: os serviços sobem em segundo plano e não voltam sozinhos depois de um reinício' 'without systemd: the services run in the background and do not come back on their own after a restart')"
}

# ---------- instalação ----------
check_system() {
  [ "$(uname -s)" = Linux ] || { echo "$(t 'só Linux' 'Linux only')"; return 1; }
  case "$(uname -m)" in
    x86_64) ;;
    armv7l|armv7) [ "$ROLE" = controller ] || { echo "$(t 'o gateway (llama-server) só existe para x86_64; neste processador instale só o controller' 'the gateway (llama-server) exists only for x86_64; on this processor install only the controller')"; return 1; } ;;
    *) echo "$(t "processador sem pacote: $(uname -m)" "processor without a package: $(uname -m)")"; return 1 ;;
  esac
  need="bootstrap.sh"
  case "$ROLE" in
    both) need="$need $BINS_SERVIDOR" ;;
    controller) need="$need ai-cluster-controller aic" ;;
    gateway) need="$need ai-cluster-gateway llama-server aic" ;;
  esac
  for b in $need; do
    [ -f "$HERE/$b" ] || { echo "$(t "falta $b ao lado do setup" "missing $b next to setup")"; return 1; }
  done
  [ "$ROLE" = gateway ] || command -v openssl >/dev/null || { echo "$(t 'precisa do openssl (apt install openssl)' 'needs openssl (apt install openssl)')"; return 1; }
  case "$ROLE" in both|gateway)
    ldconfig -p 2>/dev/null | grep -q libgomp.so.1 || { echo "$(t 'precisa do libgomp1 (apt install libgomp1)' 'needs libgomp1 (apt install libgomp1)')"; return 1; } ;;
  esac
}

# O motor fica em $PREFIX/libexec/setup (o `aic` o chama de lá). Troca por rename: pode ser ele mesmo rodando.
instala_setup() {
  mkdir -p "$PREFIX/libexec"
  troca "$HERE/setup" "$PREFIX/libexec/setup"
}

# O comando do usuário é só `aic`: carrega cli.env (se existir) e roda o binário do cluster. Apaga os nomes
# antigos, para não sobrar dois jeitos de chamar.
instala_comando() {
  rm -f /usr/local/bin/ai-cluster /usr/local/bin/aic-setup "$PREFIX/bin/ai-cluster" "$PREFIX/aic-setup"
  cat > /usr/local/bin/aic.new <<EOF
#!/bin/sh
if [ -e $CONF/cli.env ]; then
  [ -r $CONF/cli.env ] || { echo "aic: $(t 'sem acesso a' 'no access to') $CONF/cli.env (use sudo)" >&2; exit 1; }
  set -a; . $CONF/cli.env; set +a
fi
exec $PREFIX/bin/aic "\$@"
EOF
  chmod 755 /usr/local/bin/aic.new && mv -f /usr/local/bin/aic.new /usr/local/bin/aic
}

install_files() {
  id ai-cluster >/dev/null 2>&1 || useradd --system --no-create-home --home-dir "$DATA" \
    --shell /usr/sbin/nologin ai-cluster
  mkdir -p "$PREFIX/bin" "$CONF/pki" "$DATA/state" "$MODELS" "$LOGDIR" "$PREFIX/kit"
  for b in $BINS_SERVIDOR; do
    [ ! -f "$HERE/$b" ] || troca "$HERE/$b" "$PREFIX/bin/$b"
  done
  [ ! -f "$HERE/bootstrap.sh" ] || install -m 755 "$HERE/bootstrap.sh" "$PREFIX/bootstrap.sh"
  instala_setup
  instala_comando
  chown -R ai-cluster:ai-cluster "$DATA" "$LOGDIR"
  [ "$MODELS" = "$DATA/models" ] || chown ai-cluster:ai-cluster "$MODELS"
  chmod 755 "$MODELS"
}

make_credentials() {
  umask 077
  JOIN=$(rand); OPERATOR=$(rand); INFERENCE=$(rand); API_KEY="aic_$(rand)"
  {
    echo "AI_CLUSTER_JOIN_TOKEN=$JOIN"
    echo "AI_CLUSTER_OPERATOR_TOKEN=$OPERATOR"
    echo "AI_CLUSTER_INFERENCE_TOKEN=$INFERENCE"
    echo "AI_CLUSTER_INSECURE=1"
    echo "AI_CLUSTER_NODES=$DATA/state/nodes"
    echo "AI_CLUSTER_STATE=$DATA/state/state.bin"
    echo "AI_CLUSTER_EVENTS=$DATA/state/events.log"
    echo "AI_CLUSTER_MODELS_DIR=$MODELS"
    echo "AI_CLUSTER_MODELS_STATE=$DATA/state/models.state"
    echo "AI_CLUSTER_ENROLL_ADDR=$IP:$ENROLL_PORT"
  } > "$CONF/controller.env"
  {
    echo "AI_CLUSTER_INFERENCE_TOKEN=$INFERENCE"
    echo "AI_CLUSTER_API_KEY=$API_KEY"
    echo "AI_CLUSTER_INSECURE=1"
    echo "AI_CLUSTER_CONTROLLER=http://127.0.0.1:$GRPC_PORT"
    echo "AI_CLUSTER_GATEWAY_ADDR=0.0.0.0:$HTTP_PORT"
    echo "AI_CLUSTER_GATEWAY_URL=http://$IP:$HTTP_PORT"
    echo "AI_CLUSTER_MODELS_DIR=$MODELS"
    echo "AI_CLUSTER_LLAMA_SERVER_BIN=$PREFIX/bin/llama-server"
    echo "AI_CLUSTER_LLAMA_TLS_CA=$CONF/pki/ca.crt"
    echo "AI_CLUSTER_LLAMA_TLS_CERT=$CONF/pki/gateway.crt"
    echo "AI_CLUSTER_LLAMA_TLS_KEY=$CONF/pki/gateway.key"
    echo "AI_CLUSTER_LLAMA_RPC_SERVER_NAME=aic-worker-{node_id}"
    echo "AI_CLUSTER_LLAMA_CTX=2048"
    echo "AI_CLUSTER_LLAMA_SLOTS=1"
  } > "$CONF/gateway.env"
  {
    echo "AI_CLUSTER_CONTROLLER=http://127.0.0.1:$GRPC_PORT"
    echo "AI_CLUSTER_OPERATOR_TOKEN=$OPERATOR"
    echo "AI_CLUSTER_INSECURE=1"
  } > "$CONF/cli.env"
  echo "$IP" > "$CONF/server-ip"
  chown root:ai-cluster "$CONF/controller.env" "$CONF/gateway.env"
  chmod 640 "$CONF/controller.env" "$CONF/gateway.env"
  chmod 600 "$CONF/cli.env"
}

make_pki() {
  umask 077
  cd "$CONF/pki"
  # CA própria, que só assina o gateway e os workers deste cluster.
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout ca.key -out ca.crt \
    -subj "/CN=ai-cluster-ca" -days 3650 -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign,cRLSign"
  for pair in gateway:aic-gateway; do
    name=${pair%%:*}; san=${pair#*:}
    openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout "$name.key" \
      -out "$name.csr" -subj "/CN=$name"
    printf 'subjectAltName=DNS:%s\nbasicConstraints=CA:FALSE\n' "$san" > "$name.ext"
    openssl x509 -req -in "$name.csr" -CA ca.crt -CAkey ca.key -CAcreateserial -out "$name.crt" \
      -days 825 -extfile "$name.ext"
    rm -f "$name.csr" "$name.ext"
  done
  # O gateway (usuário ai-cluster) lê a própria chave; a CA e a chave do worker só o root.
  chown ai-cluster:ai-cluster gateway.key gateway.crt ca.crt
  chown root:ai-cluster "$CONF" "$CONF/pki"; chmod 750 "$CONF" "$CONF/pki"
  chmod 644 ca.crt gateway.crt; chmod 600 ca.key gateway.key
}

# Units systemd: Restart=always e WantedBy=multi-user.target, para voltar sozinhas depois de um reinício.
write_units() {
  if have_systemd; then
    for svc in $SERVICES; do
      after="network-online.target"
      [ "$svc" = gateway ] && [ "$ROLE" = both ] && after="network-online.target ai-cluster-controller.service"
      cat > "/etc/systemd/system/ai-cluster-$svc.service" <<UNIT
[Unit]
Description=AI Cluster $svc
After=$after
Wants=network-online.target

[Service]
User=ai-cluster
EnvironmentFile=$CONF/$svc.env
ExecStart=$PREFIX/bin/ai-cluster-$svc
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=$DATA $LOGDIR $MODELS

[Install]
WantedBy=multi-user.target
UNIT
    done
    systemctl daemon-reload
  fi
}

svc_start() { # svc_start controller|gateway
  svc=$1
  if have_systemd; then
    systemctl enable "ai-cluster-$svc" >/dev/null 2>&1
    systemctl restart "ai-cluster-$svc"
  else
    pidf="$DATA/state/$svc.pid"
    [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null || true
    set --
    while IFS= read -r l; do set -- "$@" "$l"; done < "$CONF/$svc.env"
    su -s /bin/sh ai-cluster -c 'pidf=$1; bin=$2; log=$3; shift 3; \
      setsid env "$@" "$bin" >> "$log" 2>&1 < /dev/null & echo $! > "$pidf"' \
      sh "$pidf" "$PREFIX/bin/ai-cluster-$svc" "$LOGDIR/$svc.log" "$@"
  fi
}

# O worker deste computador (instalado pelo convite): o mesmo jeito do bootstrap.sh.
svc_start_worker() {
  if have_systemd; then
    systemctl restart ai-cluster-worker
  else
    pidf="$PREFIX/state/worker.pid"
    [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null || true
    sleep 1
    set --
    while IFS= read -r l; do set -- "$@" "$l"; done < "$PREFIX/worker.env"
    su -s /bin/sh ai-cluster -c 'state=$1; bin=$2; shift 2; cd "$state"; \
      setsid env "$@" "$bin" >> "$state/worker.log" 2>&1 < /dev/null & \
      echo $! > "$state/worker.pid"' sh "$PREFIX/state" "$PREFIX/bin/ai-cluster-worker" "$@"
  fi
}

wait_ready() {
  i=0
  if [ "$ROLE" = worker ]; then
    until ativo ai-cluster-worker "$PREFIX/state/worker.pid"; do
      i=$((i + 1)); [ $i -gt 30 ] && { echo "$(t 'o worker não subiu em 30 s' 'the worker did not start in 30 s')"; return 1; }
      sleep 1
    done
    return 0
  fi
  if [ "$ROLE" != gateway ]; then
    until /usr/local/bin/aic cluster nodes >/dev/null 2>&1; do
      i=$((i + 1)); [ $i -gt 30 ] && { echo "$(t 'o controller não respondeu em 30 s' 'the controller did not respond in 30 s')"; return 1; }
      sleep 1
    done
  fi
  i=0
  case "$ROLE" in both|gateway)
    until ss -ltn 2>/dev/null | grep -q ":$HTTP_PORT "; do
      i=$((i + 1)); [ $i -gt 30 ] && { echo "$(t 'o gateway não respondeu em 30 s' 'the gateway did not respond in 30 s')"; return 1; }
      sleep 1
    done ;;
  esac
}

# Guarda de onde veio esta versão e em que idioma foi instalada: o convite busca daí o pacote do
# worker de cada processador, e os comandos depois (update, status) falam o mesmo idioma.
save_release() {
  {
    echo "BASE=${AIC_RELEASE_BASE:-}"
    echo "VERSION=${AIC_RELEASE_VERSION:-}"
    echo "ROLE=$ROLE"
    echo "KIND=${AIC_HW_KIND:-}"
    echo "SUMS=${AIC_RELEASE_SUMS:-}"
  } > "$CONF/release"
  chmod 644 "$CONF/release"
  echo "$LANG_AIC" > "$CONF/lang"
  chmod 644 "$CONF/lang"
}

# `controller install`: o controller (e, com --with-gateway, o gateway) neste Linux.
cmd_controller_install() {
  MODELS=$DATA/models; IP=""; YES=0; ROLE=controller
  while [ $# -gt 0 ]; do
    case "$1" in
      --with-gateway) ROLE=both; shift ;;
      --ip) [ $# -ge 2 ] || die "$(t '--ip pede um valor' '--ip needs a value')"; IP=$2; shift 2 ;;
      --models-dir) [ $# -ge 2 ] || die "$(t '--models-dir pede um valor' '--models-dir needs a value')"; MODELS=$2; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      --lang) [ $# -ge 2 ] || die "$(t '--lang pede um valor' '--lang needs a value')"; set_lang "$2"; shift 2 ;;
      *) die "$(t "argumento desconhecido: $1" "unknown argument: $1")" ;;
    esac
  done
  need_root
  [ -n "$IP" ] || IP=$(lan_ip)
  [ -n "$IP" ] || die "$(t 'não achei o IP da rede; informe com --ip' 'could not find the network IP; give it with --ip')"
  case "$IP$MODELS" in *[!A-Za-z0-9._/-]*) die "$(t '--ip e --models-dir só aceitam letras, dígitos e . _ / -' '--ip and --models-dir accept only letters, digits and . _ / -')" ;; esac
  case "$MODELS" in /home*) die "$(t '--models-dir em /home fica inacessível ao serviço (ProtectHome); use outro caminho' '--models-dir under /home is not reachable by the service (ProtectHome); use another path')" ;; /|/etc*|/usr*|/bin*|/sbin*|/lib*|/boot*|/proc*|/sys*|/dev*|*..*) die "$(t '--models-dir não pode ser um diretório do sistema nem conter ..' '--models-dir cannot be a system directory nor contain ..')" ;; /*) ;; *) die "$(t '--models-dir deve ser um caminho absoluto' '--models-dir must be an absolute path')" ;; esac
  if [ "$ROLE" = both ]; then SERVICES="controller gateway"; WHAT="Controller + gateway"; TOTAL=8
  else SERVICES=controller; WHAT="Controller"; TOTAL=6; fi
  banner controller "$(versao)" "$(t "Instalação: $WHAT" "Installation: $WHAT")"
  [ ! -f "$CONF/.installed" ] || die "$(t 'já instalado. Para um novo convite: sudo aic cluster invite' 'already installed. For a new invitation: sudo aic cluster invite')"
  note "$(t "$WHAT serão instalados neste computador ($IP)." "$WHAT will be installed on this computer ($IP).")"
  note "$(t "Modelos GGUF: $MODELS" "GGUF models: $MODELS")"
  printf '\n'
  if [ "$YES" != 1 ] && [ -t 0 ]; then
    if [ "$LANG_AIC" = en ]; then
      printf '  Continue? [Y/n] '; read -r a || a=n
      case "$a" in n|N|no|No|NO) die "cancelled" ;; esac
    else
      printf '  Continuar? [S/n] '; read -r a || a=n
      case "$a" in n|N|nao|não) die "cancelado" ;; esac
    fi
    printf '\n'
  fi
  : > "$SETUP_LOG"; chmod 600 "$SETUP_LOG"
  step "$(t 'Verificando o sistema' 'Checking the system')" check_system
  step "$(t 'Instalando os programas' 'Installing the programs')" install_files
  step "$(t 'Gerando credenciais e o comando aic' 'Generating credentials and the aic command')" make_credentials
  step "$(t 'Criando a CA e os certificados do túnel RPC' 'Creating the CA and the RPC tunnel certificates')" make_pki
  step "$(t 'Configurando os serviços' 'Configuring the services')" write_units
  step "$(t 'Subindo o controller' 'Starting the controller')" svc_start controller
  if [ "$ROLE" = both ]; then
    sleep 2
    step "$(t 'Subindo o gateway' 'Starting the gateway')" svc_start gateway
  fi
  step "$(t 'Verificando que respondem' 'Checking that they respond')" wait_ready
  save_release
  touch "$CONF/.installed"
  printf '\n'
  if [ "$ROLE" = both ]; then
    if [ "$LANG_AIC" = en ]; then
      box "Server ready" "" \
          "API (gateway)   http://$IP:$HTTP_PORT/v1/chat/completions" \
          "Controller      http://$IP:$GRPC_PORT" \
          "Models          $MODELS" \
          "Manage          aic cluster nodes | model status | model start" \
          "Credentials     $CONF  (root only)"
    else
      box "Servidor pronto" "" \
          "API (gateway)   http://$IP:$HTTP_PORT/v1/chat/completions" \
          "Controller      http://$IP:$GRPC_PORT" \
          "Modelos         $MODELS" \
          "Administrar     aic cluster nodes | model status | model start" \
          "Credenciais     $CONF  (somente root)"
    fi
  else
    if [ "$LANG_AIC" = en ]; then
      box "Controller ready" "" \
          "Controller      http://$IP:$GRPC_PORT" \
          "Models          $MODELS" \
          "Manage          aic cluster nodes | model status" \
          "Credentials     $CONF  (root only)"
    else
      box "Controller pronto" "" \
          "Controller      http://$IP:$GRPC_PORT" \
          "Modelos         $MODELS" \
          "Administrar     aic cluster nodes | model status" \
          "Credenciais     $CONF  (somente root)"
    fi
  fi
  if [ "$LANG_AIC" = en ]; then
    printf '\n  %sNext steps%s\n' "$B" "$Z"
    printf '   1. Invite each other computer:  %ssudo aic cluster invite%s\n' "$C" "$Z"
    printf '   2. Copy a .gguf model to %s\n' "$MODELS"
    [ "$ROLE" != both ] || printf '   3. Load it:                       %saic cluster model start <file.gguf>%s\n' "$C" "$Z"
  else
    printf '\n  %sPróximos passos%s\n' "$B" "$Z"
    printf '   1. Convide cada outro computador:  %ssudo aic cluster invite%s\n' "$C" "$Z"
    printf '   2. Copie um modelo .gguf para %s\n' "$MODELS"
    [ "$ROLE" != both ] || printf '   3. Carregue:                      %saic cluster model start <arquivo.gguf>%s\n' "$C" "$Z"
  fi
  sem_systemd_aviso
  printf '\n'
}

# ---------- gateway noutro computador ----------
fetch_gateway_kit() {
  t=$(mktemp -d)
  curl -fsS "http://$SERVER/gw-$CODE.tar.gz" -o "$t/k.tgz" \
    || { echo "$(t "o convite em $SERVER não respondeu; rode 'sudo aic cluster invite' no controller" "the invitation at $SERVER did not respond; run 'sudo aic cluster invite' on the controller")"; rm -rf "$t"; return 1; }
  tar -C "$t" --no-same-owner -xzf "$t/k.tgz"
  # O env vira EnvironmentFile do serviço: só entram chaves AI_CLUSTER_* com valores simples.
  if grep -qvE '^AI_CLUSTER_[A-Z_]+=[A-Za-z0-9._:/@{}-]*$' "$t/gateway.env"; then
    echo "$(t 'gateway.env recebido tem linhas inesperadas; recusado' 'received gateway.env has unexpected lines; refused')"; rm -rf "$t"; return 1
  fi
  cp "$t/ca.crt" "$t/gateway.crt" "$t/gateway.key" "$CONF/pki/"
  cp "$t/gateway.env" "$CONF/gateway.env"
  sed -i "s#^AI_CLUSTER_MODELS_DIR=.*#AI_CLUSTER_MODELS_DIR=$MODELS#" "$CONF/gateway.env"
  sed -i '/^AI_CLUSTER_GATEWAY_URL=/d' "$CONF/gateway.env"
  own_ip=$(lan_ip); [ -z "$own_ip" ] || echo "AI_CLUSTER_GATEWAY_URL=http://$own_ip:$HTTP_PORT" >> "$CONF/gateway.env"
  rm -rf "$t"
  chown ai-cluster:ai-cluster "$CONF/pki/gateway.key" "$CONF/pki/gateway.crt" "$CONF/pki/ca.crt"
  chown root:ai-cluster "$CONF" "$CONF/pki"; chmod 750 "$CONF" "$CONF/pki"
  chmod 644 "$CONF/pki/ca.crt" "$CONF/pki/gateway.crt"; chmod 600 "$CONF/pki/gateway.key"
  chown root:ai-cluster "$CONF/gateway.env"; chmod 640 "$CONF/gateway.env"
}

server_arg() { # normaliza IP -> IP:8099
  case "$1" in *:*) printf '%s' "$1" ;; *) printf '%s:8099' "$1" ;; esac
}

# `gateway install`: o gateway deste Linux, ligado a um controller pelo convite dele.
cmd_gateway_install() {
  MODELS=$DATA/models; SERVER=""; CODE=""; YES=0; ROLE=gateway; SERVICES=gateway; TOTAL=6
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) [ $# -ge 2 ] || die "$(t '--server pede um valor' '--server needs a value')"; SERVER=$2; shift 2 ;;
      --code) [ $# -ge 2 ] || die "$(t '--code pede um valor' '--code needs a value')"; CODE=$(printf '%s' "$2" | tr a-z A-Z); shift 2 ;;
      --models-dir) [ $# -ge 2 ] || die "$(t '--models-dir pede um valor' '--models-dir needs a value')"; MODELS=$2; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      --lang) [ $# -ge 2 ] || die "$(t '--lang pede um valor' '--lang needs a value')"; set_lang "$2"; shift 2 ;;
      *) die "$(t "argumento desconhecido: $1" "unknown argument: $1")" ;;
    esac
  done
  need_root
  case "$CODE" in ""|*[!A-Za-z0-9]*) die "$(t "informe o código do convite: --code (aparece no 'sudo aic cluster invite' do controller)" "give the invitation code: --code (it appears in the controller's 'sudo aic cluster invite')")" ;; esac
  [ -n "$SERVER" ] || die "$(t 'informe o controller: --server IP[:porta do convite]' 'give the controller: --server IP[:invitation port]')"
  case "$SERVER$MODELS" in *[!A-Za-z0-9._/:-]*) die "$(t '--server e --models-dir têm caracteres inválidos' '--server and --models-dir have invalid characters')" ;; esac
  SERVER=$(server_arg "$SERVER")
  case "$MODELS" in /home*) die "$(t '--models-dir em /home fica inacessível ao serviço (ProtectHome)' '--models-dir under /home is not reachable by the service (ProtectHome)')" ;; /*) ;; *) die "$(t '--models-dir deve ser um caminho absoluto' '--models-dir must be an absolute path')" ;; esac
  banner gateway "$(versao)" "$(t 'Instalação do gateway' 'Gateway installation')"
  [ ! -f "$CONF/.installed" ] || die "$(t 'já instalado neste computador' 'already installed on this computer')"
  command -v curl >/dev/null || die "$(t 'precisa do curl' 'needs curl')"
  note "$(t "O gateway será instalado aqui e ligado ao controller em ${SERVER%%:*}." "The gateway will be installed here and linked to the controller at ${SERVER%%:*}.")"
  warn "$(t "A pasta de modelos ($MODELS) precisa ser a mesma que o controller enxerga (por exemplo, compartilhada por NFS)." "The models folder ($MODELS) must be the same one the controller sees (for example, shared over NFS).")"
  printf '\n'
  : > "$SETUP_LOG"; chmod 600 "$SETUP_LOG"
  step "$(t 'Verificando o sistema' 'Checking the system')" check_system
  step "$(t 'Instalando os programas' 'Installing the programs')" install_files
  step "$(t 'Recebendo as credenciais do controller' 'Receiving the credentials from the controller')" fetch_gateway_kit
  step "$(t 'Configurando o serviço' 'Configuring the service')" write_units
  step "$(t 'Subindo o gateway' 'Starting the gateway')" svc_start gateway
  step "$(t 'Verificando que responde' 'Checking that it responds')" wait_ready
  save_release
  touch "$CONF/.installed"
  printf '\n'
  if [ "$LANG_AIC" = en ]; then
    box "Gateway ready" "" \
        "API (gateway)   http://$(lan_ip):$HTTP_PORT/v1/chat/completions" \
        "Controller      http://${SERVER%%:*}:$GRPC_PORT" \
        "Models          $MODELS"
  else
    box "Gateway pronto" "" \
        "API (gateway)   http://$(lan_ip):$HTTP_PORT/v1/chat/completions" \
        "Controller      http://${SERVER%%:*}:$GRPC_PORT" \
        "Modelos         $MODELS"
  fi
  sem_systemd_aviso
  printf '\n'
}

# ---------- worker ----------
# `worker join`: entra no cluster pelo convite. O script `join` do convite faz o trabalho (ver abaixo).
cmd_worker_join() {
  SERVER=""; CODE=""; ROLE=worker
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) [ $# -ge 2 ] || die "$(t '--server pede um valor' '--server needs a value')"; SERVER=$2; shift 2 ;;
      --code) [ $# -ge 2 ] || die "$(t '--code pede um valor' '--code needs a value')"; CODE=$(printf '%s' "$2" | tr a-z A-Z); shift 2 ;;
      --yes|-y) shift ;;
      --lang) [ $# -ge 2 ] || die "$(t '--lang pede um valor' '--lang needs a value')"; set_lang "$2"; shift 2 ;;
      *) die "$(t "argumento desconhecido: $1" "unknown argument: $1")" ;;
    esac
  done
  need_root
  case "$CODE" in ""|*[!A-Za-z0-9]*) die "$(t "informe o código do convite: --code (aparece no 'sudo aic cluster invite' do controller)" "give the invitation code: --code (shown by 'sudo aic cluster invite' on the controller)")" ;; esac
  [ -n "$SERVER" ] || die "$(t 'informe o servidor: --server IP[:porta do convite]' 'give the server: --server IP[:invitation port]')"
  case "$SERVER" in *[!A-Za-z0-9.:_-]*) die "$(t '--server com caracteres inválidos' '--server with invalid characters')" ;; esac
  SERVER=$(server_arg "$SERVER")
  banner worker "" "$(t 'Entrar no cluster como worker' 'Join the cluster as a worker')"
  note "$(t "Buscando o pacote do worker em ${SERVER%%:*}…" "Fetching the worker package from ${SERVER%%:*}…")"
  jd=$(mktemp -d)
  curl -fsS "http://$SERVER/join-$CODE" -o "$jd/join" \
    || { rm -rf "$jd"; die "$(t "o convite em $SERVER não respondeu ou o código está errado; rode 'sudo aic cluster invite' no servidor e confira o código" "the invitation at $SERVER did not respond or the code is wrong; run 'sudo aic cluster invite' on the server and check the code")"; }
  # O idioma do convite é o do servidor: o script que ele entrega não herda o deste comando.
  unset AIC_LANG
  rc=0; AIC_ARCH="${AIC_HW_ARCH:-}" sh "$jd/join" || rc=$?
  rm -rf "$jd"
  exit $rc
}

# `worker role|change|passwd`: só o AI Cluster OS tem essas ferramentas (ele tem a sua própria `setup`).
worker_so() { die "$(t 'disponível apenas no AI Cluster OS' 'available only on the AI Cluster OS')"; }

# `status` e `logs`: o estado e os registros deste computador, nos serviços locais.
mostra_estado() { # mostra_estado <componente> <serviço> <arquivo-do-pid> [porta...]
  comp=$1; svc=$2; pidf=$3; shift 3
  banner "$comp" "$(versao)" "$(t 'Estado deste computador' 'Status of this computer')"
  if ativo "$svc" "$pidf"; then st=$(t ativo running); else st=$(t parado stopped); fi
  printf '  %-14s %s\n' "$(t Serviço Service)" "$svc: $st"
  for p in "$@"; do
    if ss -ltn 2>/dev/null | grep -q ":$p "; then st=$(t aberta open); else st=$(t fechada closed); fi
    printf '  %-14s %s\n' "$(t Porta Port) $p" "$st"
  done
  v=$(versao)
  printf '  %-14s %s\n' "$(t Versão Version)" "${v:-?}"
  printf '  %-14s %s\n' "$(t Papel Role)" "$(get "$CONF/release" ROLE)"
  printf '\n'
}

mostra_logs() { # mostra_logs <serviço> <arquivo-de-log> [-f] [-n N]
  svc=$1; lg=$2; shift 2
  seg=0; n=50
  while [ $# -gt 0 ]; do
    case "$1" in
      -f) seg=1; shift ;;
      -n) [ $# -ge 2 ] || die "$(t '-n pede um número' '-n needs a number')"; n=$2; shift 2 ;;
      *) die "$(t "argumento desconhecido: $1" "unknown argument: $1")" ;;
    esac
  done
  case "$n" in ''|*[!0-9]*) die "$(t '-n pede um número' '-n needs a number')" ;; esac
  if have_systemd; then
    if [ "$seg" = 1 ]; then exec journalctl -u "$svc" -n "$n" -f --no-pager; fi
    exec journalctl -u "$svc" -n "$n" --no-pager
  fi
  [ -f "$lg" ] || die "$(t "ainda não há registros em $lg" "no logs in $lg yet")"
  if [ "$seg" = 1 ]; then exec tail -n "$n" -f "$lg"; fi
  exec tail -n "$n" "$lg"
}

# Baixa o pacote do worker de um processador para o cache, conferindo o SHA-256 da release.
fetch_worker_pack() {
  f="worker-linux-$1.tar.gz"
  [ -f "$CONF/release" ] || return 1
  base=$(get "$CONF/release" BASE)
  dest="$PREFIX/kit/$(get "$CONF/release" VERSION)-$f"   # o cache é por versão
  [ -f "$dest" ] && return 0
  [ -n "$base" ] || return 1
  t=$(mktemp -d)
  curl -fsSL "$base/SHA256SUMS" -o "$t/S" && curl -fsSL "$base/$f" -o "$t/f" || { rm -rf "$t"; return 1; }
  want=$(awk -v f="$f" '$2==f {print $1}' "$t/S"); have=$(sha256sum "$t/f" | cut -d' ' -f1)
  [ -n "$want" ] && [ "$want" = "$have" ] || { rm -rf "$t"; return 1; }
  mv "$t/f" "$dest"; rm -rf "$t"
}

# `cluster invite`: abre o convite (janela curta) para computadores novos entrarem no cluster.
cmd_invite() {
  MIN=15; PORT=8099
  while [ $# -gt 0 ]; do
    case "$1" in
      --minutes) [ $# -ge 2 ] || die "$(t '--minutes pede um valor' '--minutes needs a value')"; MIN=$2; shift 2 ;;
      --port) [ $# -ge 2 ] || die "$(t '--port pede um valor' '--port needs a value')"; PORT=$2; shift 2 ;;
      *) die "$(t "argumento desconhecido: $1" "unknown argument: $1")" ;;
    esac
  done
  need_root
  [ -f "$CONF/.installed" ] || die "$(t 'instale o controller antes: sudo aic controller install' 'install the controller first: sudo aic controller install')"
  case "$MIN" in ''|*[!0-9]*) die "$(t '--minutes deve ser um número' '--minutes must be a number')" ;; esac
  case "$PORT" in ''|*[!0-9]*) die "$(t '--port deve ser um número' '--port must be a number')" ;; esac
  [ "$MIN" -ge 1 ] || die "$(t '--minutes deve ser pelo menos 1' '--minutes must be at least 1')"
  command -v python3 >/dev/null || die "$(t 'precisa do python3 para servir o convite (apt install python3)' 'needs python3 to serve the invitation (apt install python3)')"
  banner convite "$(versao)" "$(t 'Convite de computadores' 'Computer invitation')"
  IP=$(cat "$CONF/server-ip")
  JOIN=$(get "$CONF/controller.env" AI_CLUSTER_JOIN_TOKEN)
  mkdir -p "$PREFIX/kit"
  # O pacote do worker de cada processador vem da release desta versão e fica em cache no servidor.
  AVAILABLE=""
  for a in x86_64 armv7; do
    if fetch_worker_pack "$a"; then AVAILABLE="$AVAILABLE $a"
    else warn "$(t "sem pacote de worker para $a (sem internet ou a release não o traz)" "no worker package for $a (no internet, or the release does not include it)")"; fi
  done
  [ -n "$AVAILABLE" ] || die "$(t 'nenhum pacote de worker disponível; confira a internet do servidor' 'no worker package available; check the server internet connection')"
  WEB=$(mktemp -d); GCODE=$(head -c 512 /dev/urandom | LC_ALL=C tr -dc 'A-HJ-NP-Z2-9' | head -c 8)
  SUMS=""
  for a in $AVAILABLE; do
    cp "$PREFIX/kit/$(get "$CONF/release" VERSION)-worker-linux-$a.tar.gz" "$WEB/worker-linux-$a.tar.gz"
    SUMS="$SUMS
  $a) SUM=$(sha256sum "$WEB/worker-linux-$a.tar.gz" | cut -d' ' -f1) ;;"
  done
  cp "$PREFIX/bootstrap.sh" "$WEB/bootstrap.sh"
  cp "$PREFIX/libexec/setup" "$WEB/setup"
  # Credenciais do túnel RPC dos workers e o kit do gateway (só dentro da janela do convite).
  tar -C "$CONF/pki" -czf "$WEB/pki-worker.tar.gz" ca.crt
  g=$(mktemp -d)
  cp "$CONF/pki/ca.crt" "$CONF/pki/gateway.crt" "$CONF/pki/gateway.key" "$g/"
  sed -e "s#^AI_CLUSTER_CONTROLLER=.*#AI_CLUSTER_CONTROLLER=http://$IP:$GRPC_PORT#" -e '/^AI_CLUSTER_GATEWAY_URL=/d' "$CONF/gateway.env" > "$g/gateway.env"
  tar -C "$g" -czf "$WEB/gw-$GCODE.tar.gz" .
  rm -rf "$g"
  BSUM=$(sha256sum "$WEB/bootstrap.sh" | cut -d' ' -f1); PSUM=$(sha256sum "$WEB/pki-worker.tar.gz" | cut -d' ' -f1)
  SETSUM=$(sha256sum "$WEB/setup" | cut -d' ' -f1)
  # A release do servidor vai gravada no worker (release): é a origem da atualização dele.
  RBASE=$(get "$CONF/release" BASE); RVER=$(get "$CONF/release" VERSION); RSUMS=$(get "$CONF/release" SUMS)
  # Os scripts que a outra máquina baixa são gerados no idioma deste servidor (fixado aqui).
  # O script para entrar como worker: escolhe o pacote pelo processador, confere e instala.
  if [ "$LANG_AIC" = en ]; then
    cat > "$WEB/join-$GCODE" <<JOIN_SCRIPT
#!/bin/sh
# AI Cluster — joins this cluster as a worker.  Usage: curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh
set -eu
[ "\$(id -u)" = 0 ] || { echo "run with sudo: curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh" >&2; exit 1; }
case "\$(uname -m)" in
  x86_64) A=x86_64 ;; armv7l|armv7) A=armv7 ;;
  *) echo "this computer is \$(uname -m): there is no worker package for it yet" >&2; exit 1 ;;
esac
[ -z "\${AIC_ARCH:-}" ] || [ "\$AIC_ARCH" = "\$A" ] || { echo "you chose \$AIC_ARCH, but this computer is \$A" >&2; exit 1; }
case "\$A" in $SUMS
  *) echo "the server has no worker package for \$A" >&2; exit 1 ;;
esac
[ "\$A" != x86_64 ] || ldconfig -p 2>/dev/null | grep -q libgomp.so.1 || echo "warning: libgomp1 is missing (apt install libgomp1)" >&2
T=\$(mktemp -d); trap 'rm -rf "\$T"' EXIT
echo "AI Cluster: downloading the worker package (\$A) from $IP…"
curl -fsS http://$IP:$PORT/worker-linux-\$A.tar.gz -o "\$T/w.tgz"
echo "\$SUM  \$T/w.tgz" | sha256sum -c - >/dev/null || { echo "corrupted or tampered package" >&2; exit 1; }
mkdir "\$T/w"; tar -C "\$T/w" -xzf "\$T/w.tgz"
curl -fsS http://$IP:$PORT/bootstrap.sh -o "\$T/bootstrap.sh"
curl -fsS http://$IP:$PORT/setup -o "\$T/setup"
curl -fsS http://$IP:$PORT/pki-worker.tar.gz -o "\$T/pki.tgz"
echo "$BSUM  \$T/bootstrap.sh" | sha256sum -c - >/dev/null || { echo "bootstrap.sh tampered" >&2; exit 1; }
echo "$SETSUM  \$T/setup" | sha256sum -c - >/dev/null || { echo "setup tampered" >&2; exit 1; }
echo "$PSUM  \$T/pki.tgz" | sha256sum -c - >/dev/null || { echo "certificates tampered" >&2; exit 1; }
id ai-cluster >/dev/null 2>&1 || useradd --system --no-create-home --home-dir /opt/ai-cluster/state --shell /usr/sbin/nologin ai-cluster
mkdir -p /etc/ai-cluster/rpc-tls /opt/ai-cluster/bin /opt/ai-cluster/libexec
tar -C /etc/ai-cluster/rpc-tls --no-same-owner -xzf "\$T/pki.tgz"
chmod 644 /etc/ai-cluster/rpc-tls/ca.crt
install -m 755 "\$T/w/ggml-rpc-server" /usr/local/bin/ggml-rpc-server
install -m 755 "\$T/w/aic" /opt/ai-cluster/bin/aic
install -m 755 "\$T/setup" /opt/ai-cluster/libexec/setup
rm -f /usr/local/bin/ai-cluster /usr/local/bin/aic-setup
cat > /usr/local/bin/aic <<'AIC_WRAP'
#!/bin/sh
if [ -e /etc/ai-cluster/cli.env ]; then
  [ -r /etc/ai-cluster/cli.env ] || { echo "aic: no access to /etc/ai-cluster/cli.env (use sudo)" >&2; exit 1; }
  set -a; . /etc/ai-cluster/cli.env; set +a
fi
exec /opt/ai-cluster/bin/aic "\$@"
AIC_WRAP
chmod 755 /usr/local/bin/aic
printf 'ROLE=worker\nBASE=$RBASE\nVERSION=$RVER\nSUMS=$RSUMS\n' > /etc/ai-cluster/release
touch /etc/ai-cluster/.installed
echo en > /etc/ai-cluster/lang
printf '%s\n' "$JOIN" > "\$T/join-token"; chmod 600 "\$T/join-token"
NAME=\$(hostname | sed 's/[^A-Za-z0-9.-]/-/g' | cut -c1-40)
# Chave própria: nasce e fica neste computador. O servidor só assina o pedido (CSR), com o nome do nó
# no certificado, então um worker comprometido não se passa por outro.
command -v openssl >/dev/null || { echo "needs openssl (apt install openssl)" >&2; exit 1; }
( umask 077; openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
    -keyout /etc/ai-cluster/rpc-tls/worker.key -out "\$T/worker.csr" -subj "/CN=\$NAME" >/dev/null 2>&1 )
curl -fsS --data-binary @"\$T/worker.csr" "http://$IP:$PORT/sign?name=\$NAME&code=$GCODE" -o /etc/ai-cluster/rpc-tls/worker.crt \
  || { echo "the server did not sign the node certificate (is the name already used in this invitation? open another with sudo aic cluster invite)" >&2; exit 1; }
openssl verify -CAfile /etc/ai-cluster/rpc-tls/ca.crt /etc/ai-cluster/rpc-tls/worker.crt >/dev/null \
  || { echo "node certificate does not match the cluster CA" >&2; exit 1; }
chmod 644 /etc/ai-cluster/rpc-tls/worker.crt
chown root:ai-cluster /etc/ai-cluster/rpc-tls/worker.key; chmod 640 /etc/ai-cluster/rpc-tls/worker.key
AIC_INVITED=1 AIC_LANG=en sh "\$T/bootstrap.sh" --controller http://$IP:$GRPC_PORT --insecure \
  --token-file "\$T/join-token" --binary "\$T/w/ai-cluster-worker" --node-id "\$NAME" \
  --rpc-server-bin /usr/local/bin/ggml-rpc-server --rpc-tls-dir /etc/ai-cluster/rpc-tls </dev/null
echo "Done: \$NAME joined the cluster. The server approves the node shortly."
JOIN_SCRIPT
  else
    cat > "$WEB/join-$GCODE" <<JOIN_SCRIPT
#!/bin/sh
# AI Cluster — entra neste cluster como worker.  Uso: curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh
set -eu
[ "\$(id -u)" = 0 ] || { echo "rode com sudo: curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh" >&2; exit 1; }
case "\$(uname -m)" in
  x86_64) A=x86_64 ;; armv7l|armv7) A=armv7 ;;
  *) echo "este computador é \$(uname -m): ainda não há pacote de worker para ele" >&2; exit 1 ;;
esac
[ -z "\${AIC_ARCH:-}" ] || [ "\$AIC_ARCH" = "\$A" ] || { echo "você informou \$AIC_ARCH, mas este computador é \$A" >&2; exit 1; }
case "\$A" in $SUMS
  *) echo "o servidor não tem pacote de worker para \$A" >&2; exit 1 ;;
esac
[ "\$A" != x86_64 ] || ldconfig -p 2>/dev/null | grep -q libgomp.so.1 || echo "aviso: falta libgomp1 (apt install libgomp1)" >&2
T=\$(mktemp -d); trap 'rm -rf "\$T"' EXIT
echo "AI Cluster: baixando o pacote do worker (\$A) de $IP…"
curl -fsS http://$IP:$PORT/worker-linux-\$A.tar.gz -o "\$T/w.tgz"
echo "\$SUM  \$T/w.tgz" | sha256sum -c - >/dev/null || { echo "pacote corrompido ou adulterado" >&2; exit 1; }
mkdir "\$T/w"; tar -C "\$T/w" -xzf "\$T/w.tgz"
curl -fsS http://$IP:$PORT/bootstrap.sh -o "\$T/bootstrap.sh"
curl -fsS http://$IP:$PORT/setup -o "\$T/setup"
curl -fsS http://$IP:$PORT/pki-worker.tar.gz -o "\$T/pki.tgz"
echo "$BSUM  \$T/bootstrap.sh" | sha256sum -c - >/dev/null || { echo "bootstrap.sh adulterado" >&2; exit 1; }
echo "$SETSUM  \$T/setup" | sha256sum -c - >/dev/null || { echo "setup adulterado" >&2; exit 1; }
echo "$PSUM  \$T/pki.tgz" | sha256sum -c - >/dev/null || { echo "certificados adulterados" >&2; exit 1; }
id ai-cluster >/dev/null 2>&1 || useradd --system --no-create-home --home-dir /opt/ai-cluster/state --shell /usr/sbin/nologin ai-cluster
mkdir -p /etc/ai-cluster/rpc-tls /opt/ai-cluster/bin /opt/ai-cluster/libexec
tar -C /etc/ai-cluster/rpc-tls --no-same-owner -xzf "\$T/pki.tgz"
chmod 644 /etc/ai-cluster/rpc-tls/ca.crt
install -m 755 "\$T/w/ggml-rpc-server" /usr/local/bin/ggml-rpc-server
install -m 755 "\$T/w/aic" /opt/ai-cluster/bin/aic
install -m 755 "\$T/setup" /opt/ai-cluster/libexec/setup
rm -f /usr/local/bin/ai-cluster /usr/local/bin/aic-setup
cat > /usr/local/bin/aic <<'AIC_WRAP'
#!/bin/sh
if [ -e /etc/ai-cluster/cli.env ]; then
  [ -r /etc/ai-cluster/cli.env ] || { echo "aic: sem acesso a /etc/ai-cluster/cli.env (use sudo)" >&2; exit 1; }
  set -a; . /etc/ai-cluster/cli.env; set +a
fi
exec /opt/ai-cluster/bin/aic "\$@"
AIC_WRAP
chmod 755 /usr/local/bin/aic
printf 'ROLE=worker\nBASE=$RBASE\nVERSION=$RVER\nSUMS=$RSUMS\n' > /etc/ai-cluster/release
touch /etc/ai-cluster/.installed
echo pt > /etc/ai-cluster/lang
printf '%s\n' "$JOIN" > "\$T/join-token"; chmod 600 "\$T/join-token"
NAME=\$(hostname | sed 's/[^A-Za-z0-9.-]/-/g' | cut -c1-40)
# Chave própria: nasce e fica neste computador. O servidor só assina o pedido (CSR), com o nome do nó
# no certificado, então um worker comprometido não se passa por outro.
command -v openssl >/dev/null || { echo "precisa do openssl (apt install openssl)" >&2; exit 1; }
( umask 077; openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
    -keyout /etc/ai-cluster/rpc-tls/worker.key -out "\$T/worker.csr" -subj "/CN=\$NAME" >/dev/null 2>&1 )
curl -fsS --data-binary @"\$T/worker.csr" "http://$IP:$PORT/sign?name=\$NAME&code=$GCODE" -o /etc/ai-cluster/rpc-tls/worker.crt \
  || { echo "o servidor não assinou o certificado do nó (o nome já foi usado neste convite? abra outro com sudo aic cluster invite)" >&2; exit 1; }
openssl verify -CAfile /etc/ai-cluster/rpc-tls/ca.crt /etc/ai-cluster/rpc-tls/worker.crt >/dev/null \
  || { echo "certificado do nó não confere com a CA do cluster" >&2; exit 1; }
chmod 644 /etc/ai-cluster/rpc-tls/worker.crt
chown root:ai-cluster /etc/ai-cluster/rpc-tls/worker.key; chmod 640 /etc/ai-cluster/rpc-tls/worker.key
AIC_INVITED=1 AIC_LANG=pt sh "\$T/bootstrap.sh" --controller http://$IP:$GRPC_PORT --insecure \
  --token-file "\$T/join-token" --binary "\$T/w/ai-cluster-worker" --node-id "\$NAME" \
  --rpc-server-bin /usr/local/bin/ggml-rpc-server --rpc-tls-dir /etc/ai-cluster/rpc-tls </dev/null
echo "Pronto: \$NAME entrou no cluster. O servidor aprova o nó em instantes."
JOIN_SCRIPT
  fi
  # O script para quem já tem Linux e quer instalar o AI Cluster OS (modo dedicado): confere o
  # ambiente, baixa só o aic-wait e o roda. Nada é instalado nem apagado sem a aprovação do operador.
  if [ "$LANG_AIC" = en ]; then
    cat > "$WEB/wait" <<WAIT_SCRIPT
#!/bin/sh
# AI Cluster — presents this computer to the cluster to install the AI Cluster OS (dedicated mode).
# Usage: curl -fsSL http://$IP:$PORT/wait | sudo sh
set -eu
[ "\$(id -u)" = 0 ] || { echo "run with sudo: curl -fsSL http://$IP:$PORT/wait | sudo sh" >&2; exit 1; }
case "\$(uname -m)" in
  x86_64) A=x86_64 ;; armv7l|armv7) A=armv7 ;;
  *) echo "this computer is \$(uname -m): there is no installation for it yet" >&2; exit 1 ;;
esac
case "\$A" in $SUMS
  *) echo "the server has no package for \$A" >&2; exit 1 ;;
esac
T=\$(mktemp -d); trap 'rm -rf "\$T"' EXIT
FREE=\$(df -Pk "\$T" | awk 'NR==2 {print \$4}')
[ "\${FREE:-0}" -ge 51200 ] || { echo "low disk space in \$T (needs 50 MB)" >&2; exit 1; }
if [ -d /sys/firmware/efi ]; then FW=uefi; else FW="u-boot or BIOS"; fi
echo "AI Cluster: this computer is \$A, firmware \$FW."
echo "AI Cluster: downloading the waiting step from $IP…"
curl -fsS http://$IP:$PORT/worker-linux-\$A.tar.gz -o "\$T/w.tgz"
echo "\$SUM  \$T/w.tgz" | sha256sum -c - >/dev/null || { echo "corrupted or tampered package" >&2; exit 1; }
tar -C "\$T" -xzf "\$T/w.tgz" ./aic-wait 2>/dev/null || { echo "this release's package does not include aic-wait" >&2; exit 1; }
chmod 755 "\$T/aic-wait"
# Não instala nem apaga nada: mostra o resumo e a impressão digital e espera a aprovação no servidor.
AIC_INSTALL_OUT=/run/aic-install.json "\$T/aic-wait" http://$IP:$ENROLL_PORT
WAIT_SCRIPT
  else
    cat > "$WEB/wait" <<WAIT_SCRIPT
#!/bin/sh
# AI Cluster — apresenta este computador ao cluster para instalar o AI Cluster OS (modo dedicado).
# Uso: curl -fsSL http://$IP:$PORT/wait | sudo sh
set -eu
[ "\$(id -u)" = 0 ] || { echo "rode com sudo: curl -fsSL http://$IP:$PORT/wait | sudo sh" >&2; exit 1; }
case "\$(uname -m)" in
  x86_64) A=x86_64 ;; armv7l|armv7) A=armv7 ;;
  *) echo "este computador é \$(uname -m): ainda não há instalação para ele" >&2; exit 1 ;;
esac
case "\$A" in $SUMS
  *) echo "o servidor não tem o pacote para \$A" >&2; exit 1 ;;
esac
T=\$(mktemp -d); trap 'rm -rf "\$T"' EXIT
FREE=\$(df -Pk "\$T" | awk 'NR==2 {print \$4}')
[ "\${FREE:-0}" -ge 51200 ] || { echo "pouco espaço livre em \$T (precisa de 50 MB)" >&2; exit 1; }
if [ -d /sys/firmware/efi ]; then FW=uefi; else FW="u-boot ou BIOS"; fi
echo "AI Cluster: este computador é \$A, firmware \$FW."
echo "AI Cluster: baixando a etapa de espera de $IP…"
curl -fsS http://$IP:$PORT/worker-linux-\$A.tar.gz -o "\$T/w.tgz"
echo "\$SUM  \$T/w.tgz" | sha256sum -c - >/dev/null || { echo "pacote corrompido ou adulterado" >&2; exit 1; }
tar -C "\$T" -xzf "\$T/w.tgz" ./aic-wait 2>/dev/null || { echo "o pacote desta versão não traz o aic-wait" >&2; exit 1; }
chmod 755 "\$T/aic-wait"
# Não instala nem apaga nada: mostra o resumo e a impressão digital e espera a aprovação no servidor.
AIC_INSTALL_OUT=/run/aic-install.json "\$T/aic-wait" http://$IP:$ENROLL_PORT
WAIT_SCRIPT
  fi
  # Para quem já é um AI Cluster OS e só quer mudar de controller (`aic worker change` no nó): endereço e
  # token, sob o código do convite como o /join.
  printf 'AI_CLUSTER_CONTROLLER=http://%s:%s
AI_CLUSTER_JOIN_TOKEN=%s
' "$IP" "$GRPC_PORT" "$JOIN" > "$WEB/node-$GCODE"
  cd "$WEB"
  # Servidor do convite: arquivos sem listagem de diretório (o código do gateway não pode ser
  # descoberto olhando a raiz) e POST /sign?name=<nó>, que assina o pedido de certificado do worker.
  HD=$(mktemp -d)
  cat > "$HD/invite.py" <<'PYSERVER'
import hmac, http.server, os, re, subprocess, sys, tempfile, threading

CA = os.environ["AIC_CA_DIR"]
CODE = os.environ["AIC_INVITE_CODE"]
MAX_WRONG = 30  # o código é curto: tentativas erradas demais travam o convite até ele ser aberto de novo
wrong = 0
SIGNED = os.environ["AIC_SIGNED_LOG"]
LOCK = threading.Lock()  # o ca.srl é lido e regravado pelo openssl: um pedido por vez
done = set()  # nomes já assinados nesta janela


def wrong_guess():
    global wrong
    with LOCK:
        wrong += 1


class H(http.server.SimpleHTTPRequestHandler):
    timeout = 10  # cliente que anuncia corpo e não envia não segura a thread

    def do_GET(self):
        # Os arquivos com o código no nome (join, gateway) são a parte secreta: pedir um que não existe
        # é chute, e chutes demais travam o convite.
        if self.path.startswith(("/join-", "/gw-", "/node-")):
            if wrong >= MAX_WRONG:
                return self.send_error(429)
            if not os.path.exists(self.translate_path(self.path)):
                wrong_guess()
                return self.send_error(404)
        return super().do_GET()

    def list_directory(self, path):
        self.send_error(404)

    def do_POST(self):
        m = re.fullmatch(r"/sign\?name=([A-Za-z0-9.-]{1,40})&code=([A-Za-z0-9]{1,64})", self.path)
        size = int(self.headers.get("Content-Length") or 0)
        if not m or not 0 < size <= 8192:
            return self.send_error(400)
        if wrong >= MAX_WRONG:
            return self.send_error(429)
        if not hmac.compare_digest(m.group(2).upper(), CODE):  # sem o código do convite ninguém ganha certificado
            wrong_guess()
            return self.send_error(403)
        name = m.group(1)
        with LOCK:
            if name in done:  # quem entra de novo com o mesmo nome precisa de outro convite
                return self.send_error(409)
            done.add(name)
        with tempfile.TemporaryDirectory() as d:
            csr, crt, ext = (os.path.join(d, n) for n in ("w.csr", "w.crt", "w.ext"))
            open(csr, "wb").write(self.rfile.read(size))
            with open(ext, "w") as f:
                f.write("subjectAltName=DNS:aic-worker-%s\nbasicConstraints=CA:FALSE\nextendedKeyUsage=serverAuth\n" % name)
            with LOCK:
                ok = subprocess.run(["openssl", "req", "-noout", "-verify", "-in", csr], capture_output=True).returncode == 0 and subprocess.run(
                    ["openssl", "x509", "-req", "-in", csr, "-CA", CA + "/ca.crt", "-CAkey", CA + "/ca.key",
                     "-CAcreateserial", "-out", crt, "-days", "825", "-extfile", ext],
                    capture_output=True).returncode == 0
            if not ok:
                with LOCK:
                    done.discard(name)
                return self.send_error(400)
            body = open(crt, "rb").read()
        with open(SIGNED, "a") as log:
            log.write(name + "\n")
        self.send_response(200)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)


http.server.ThreadingHTTPServer((sys.argv[1], int(sys.argv[2])), H).serve_forever()
PYSERVER
  : > "$HD/signed"
  AIC_CA_DIR="$CONF/pki" AIC_INVITE_CODE="$GCODE" AIC_SIGNED_LOG="$HD/signed" python3 "$HD/invite.py" "$IP" "$PORT" >/dev/null 2>&1 &
  SRV=$!
  MSG_CLOSED=$(t "Convite encerrado." "Invitation closed.")
  # Qualquer saída (erro, Ctrl+C, fim do prazo) derruba o servidor e apaga o que ele servia.
  trap 'kill "$SRV" 2>/dev/null; rm -rf "$WEB" "$HD"; /usr/local/bin/aic cluster install close >/dev/null 2>&1 || true' EXIT
  trap 'printf "\n  %s\n\n" "$MSG_CLOSED"; exit 0' INT TERM
  sleep 1
  kill -0 "$SRV" 2>/dev/null || die "$(t "não consegui abrir a porta $PORT em $IP (em uso?)" "could not open port $PORT on $IP (in use?)")"
  # Instalação com aprovação: a porta de espera existe desde a instalação do servidor (servidor mais
  # antigo: acrescenta e reinicia o controller uma vez) e só aceita aparelhos enquanto este convite vale.
  if ! grep -q '^AI_CLUSTER_ENROLL_ADDR=' "$CONF/controller.env"; then
    echo "AI_CLUSTER_ENROLL_ADDR=$IP:$ENROLL_PORT" >> "$CONF/controller.env"
    warn "$(t 'habilitei a porta de espera da instalação e reiniciei o controller (os workers voltam sozinhos)' 'enabled the installation waiting port and restarted the controller (the workers come back on their own)')"
    svc_start controller
    sleep 2
  fi
  /usr/local/bin/aic cluster install open --minutes "$MIN" >/dev/null 2>&1 \
    || warn "$(t 'não consegui abrir a porta de espera da instalação; o /wait não vai funcionar' 'could not open the installation waiting port; /wait will not work')"
  if [ "$LANG_AIC" = en ]; then
    box "Worker (any x86_64 or 32-bit ARM computer), run:" "" \
        "curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh" "" \
        "Gateway on another computer: sudo aic gateway install --server $IP:$PORT --code $GCODE" "" \
        "Install the AI Cluster OS (dedicated mode) on a computer that already has Linux:" "" \
        "curl -fsSL http://$IP:$PORT/wait | sudo sh" "" \
        "Valid for $MIN min. Linux with systemd and, on x86_64, libgomp1."
    printf '\n  %sWaiting for computers… (Ctrl+C ends the invitation)%s\n\n' "$D" "$Z"
  else
    box "Worker (qualquer computador x86_64 ou ARM de 32 bits), rode:" "" \
        "curl -fsSL http://$IP:$PORT/join-$GCODE | sudo sh" "" \
        "Gateway noutro computador: sudo aic gateway install --server $IP:$PORT --code $GCODE" "" \
        "Instalar o AI Cluster OS (modo dedicado) num computador que já tem Linux:" "" \
        "curl -fsSL http://$IP:$PORT/wait | sudo sh" "" \
        "Válido por $MIN min. Linux com systemd e, no x86_64, libgomp1."
    printf '\n  %sAguardando computadores… (Ctrl+C encerra o convite)%s\n\n' "$D" "$Z"
  fi
  END=$(( $(date +%s) + MIN * 60 )); SEEN=0; : > "$HD/seen-installs"
  while [ "$(date +%s)" -lt "$END" ]; do
    # Cada certificado que o convite assina aparece aqui: um nome que você não reconhece é um intruso.
    TOTAL_SIGNED=$(wc -l < "$HD/signed" | tr -d ' ')
    if [ "$TOTAL_SIGNED" -gt "$SEEN" ]; then
      tail -n +$((SEEN + 1)) "$HD/signed" | while read -r n; do
        printf '  %s•%s %s %s\n' "$C" "$Z" "$(t 'certificado do túnel emitido para' 'tunnel certificate issued for')" "$n"
      done
      SEEN=$TOTAL_SIGNED
    fi
    # Aparelhos que pediram para instalar: o operador confere a impressão digital e escolhe o disco.
    /usr/local/bin/aic cluster install list 2>/dev/null | grep '^INSTALAÇÃO fingerprint=' | while read -r _ fp rest; do
      f=${fp#fingerprint=}
      grep -qx "$f" "$HD/seen-installs" && continue
      echo "$f" >> "$HD/seen-installs"
      info=$(echo "$rest" | sed 's/ cpu=.*//; s/^aguardando //')
      if [ "$LANG_AIC" = en ]; then
        printf '  %s•%s device %s wants to install (%s)\n    check the fingerprint on its screen and approve: aic cluster install approve %s --disk <disk>\n' "$C" "$Z" "$f" "$info" "$f"
      else
        printf '  %s•%s aparelho %s quer instalar (%s)\n    confira a impressão digital na tela dele e aprove: aic cluster install approve %s --disk <disco>\n' "$C" "$Z" "$f" "$info" "$f"
      fi
    done || true
    # Nós pendentes enquanto o convite está aberto são aprovados: foi o operador quem os convidou.
    /usr/local/bin/aic cluster nodes 2>/dev/null | awk '$0 ~ /pendente/ {print $1}' | while read -r n; do
      case "$n" in -*) continue ;; esac
      /usr/local/bin/aic cluster node approve "$n" --trust-listed >/dev/null 2>&1 \
        && printf '  %s✔%s %s %s\n' "$G" "$Z" "$n" "$(t 'entrou e foi aprovado' 'joined and was approved')"
      true
    done || true
    sleep 3
  done
  if [ "$LANG_AIC" = en ]; then
    printf '\n  Invitation expired. For another: sudo aic cluster invite\n\n'
  else
    printf '\n  Convite expirou. Para outro: sudo aic cluster invite\n\n'
  fi
}

# ---------- atualização ----------
# Acrescenta KEY=VALOR a um arquivo de ambiente se a chave ainda não existe (config nova de uma versão nova).
ensure_env() { # ensure_env <arquivo> <CHAVE> <VALOR>
  grep -q "^$2=" "$1" 2>/dev/null || echo "$2=$3" >> "$1"
}

# Onde cada binário da release vai parar neste computador.
dest_de() {
  case "$1" in ggml-rpc-server) echo /usr/local/bin/ggml-rpc-server ;; *) echo "$PREFIX/bin/$1" ;; esac
}

reinicia_servicos() {
  if [ "$ROLE" = worker ]; then svc_start_worker; return; fi
  for svc in $SERVICES; do
    svc_start "$svc"
    [ "$svc" != controller ] || sleep 2
  done
}

# `update status` (só consulta a origem) e `update apply` (instala). Vale para controller, gateway e worker.
cmd_update() {
  ACAO=${1:-}; [ $# -eq 0 ] || shift
  case "$ACAO" in status|apply) ;; *) usage ;; esac
  FORCE=0; YES=0; WANT=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --force) FORCE=1; shift ;;
      --yes|-y) YES=1; shift ;;
      --version) [ $# -ge 2 ] || die "$(t '--version pede um valor' '--version needs a value')"; WANT=$2; shift 2 ;;
      --lang) [ $# -ge 2 ] || die "$(t '--lang pede um valor' '--lang needs a value')"; set_lang "$2"; shift 2 ;;
      *) die "$(t "argumento desconhecido: $1" "unknown argument: $1")" ;;
    esac
  done
  need_root
  [ -f "$CONF/.installed" ] || die "$(t 'nada instalado aqui: use o install.sh' 'nothing installed here: use install.sh')"
  ROLE=$(get "$CONF/release" ROLE); [ -n "$ROLE" ] || ROLE=both
  case "$ROLE" in both|controller|gateway|worker) ;; *) die "$(t "papel desconhecido em $CONF/release: $ROLE" "unknown role in $CONF/release: $ROLE")" ;; esac
  BASE=$(get "$CONF/release" BASE)
  [ -n "$BASE" ] || BASE="https://github.com/julianscunha/Real.AI.Cluster/releases/latest/download"
  [ -z "$WANT" ] || BASE="https://github.com/julianscunha/Real.AI.Cluster/releases/download/v$WANT"
  case "$(uname -m)" in
    x86_64) A=x86_64 ;; armv7l|armv7) A=armv7 ;;
    *) die "$(t "processador sem pacote: $(uname -m)" "no package for this processor: $(uname -m)")" ;;
  esac
  PROTO=""; case "$BASE" in https://*) PROTO="--proto =https --tlsv1.2" ;; esac
  banner atualização "$(versao)" "$(t 'Atualização' 'Update')"
  U=$(mktemp -d); trap 'rm -rf "$U"' EXIT
  curl -fsSL $PROTO -o "$U/SHA256SUMS" "$BASE/SHA256SUMS" && curl -fsSL $PROTO -o "$U/VERSION" "$BASE/VERSION" \
    || die "$(t "não consegui ler a release em $BASE" "could not read the release at $BASE")"
  NEWV=$(cat "$U/VERSION"); OLDV=$(get "$CONF/release" VERSION)
  NEWSUM=$(sha256sum "$U/SHA256SUMS" | cut -d' ' -f1)
  if [ "$ACAO" = status ]; then
    if [ "$NEWSUM" = "$(get "$CONF/release" SUMS)" ]; then
      printf '  %s✔%s %s\n\n' "$G" "$Z" "$(t "já está na versão mais recente (${NEWV})" "already on the latest version (${NEWV})")"
    else
      note "$(t "Versão instalada: ${OLDV:-?}  ->  disponível: $NEWV" "Installed version: ${OLDV:-?}  ->  available: $NEWV")"
      note "$(t 'Para atualizar: sudo aic update apply' 'To update: sudo aic update apply')"
      printf '\n'
    fi
    return 0
  fi
  if [ "$FORCE" != 1 ] && [ "$NEWSUM" = "$(get "$CONF/release" SUMS)" ]; then
    printf '  %s✔%s %s\n\n' "$G" "$Z" "$(t "já está na versão mais recente (${NEWV})" "already on the latest version (${NEWV})")"
    return 0
  fi
  note "$(t "Versão instalada: ${OLDV:-?}  ->  disponível: $NEWV" "Installed version: ${OLDV:-?}  ->  available: $NEWV")"
  case "$ROLE" in
    both) NEED="tools controller-linux-$A gateway-linux-$A"; SERVICES="controller gateway"; BINS="$BINS_SERVIDOR" ;;
    controller) NEED="tools controller-linux-$A"; SERVICES="controller"; BINS="ai-cluster-controller aic" ;;
    gateway) NEED="tools gateway-linux-$A"; SERVICES="gateway"; BINS="ai-cluster-gateway llama-server aic" ;;
    worker) NEED="worker-linux-$A"; SERVICES=""; BINS="ai-cluster-worker ggml-rpc-server aic" ;;
  esac
  if [ "$YES" != 1 ] && [ -t 0 ]; then
    if [ "$LANG_AIC" = en ]; then
      printf '  Update now? Workers, tokens and certificates stay. [Y/n] '; read -r a || a=n
      case "$a" in n|N|no|No|NO) die "cancelled" ;; esac
    else
      printf '  Atualizar agora? Workers, tokens e certificados continuam. [S/n] '; read -r a || a=n
      case "$a" in n|N|nao|não) die "cancelado" ;; esac
    fi
  fi
  mkdir -p "$U/new"
  for f in $NEED; do
    curl -fL $PROTO --progress-bar -o "$U/$f.tar.gz" "$BASE/$f.tar.gz" || die "$(t "não consegui baixar $f" "could not download $f")"
    want=$(awk -v f="$f.tar.gz" '$2==f {print $1}' "$U/SHA256SUMS")
    [ -n "$want" ] && [ "$want" = "$(sha256sum "$U/$f.tar.gz" | cut -d' ' -f1)" ] \
      || die "$(t "$f não confere com o SHA256SUMS (corrompido ou adulterado)" "$f does not match SHA256SUMS (corrupted or tampered)")"
    tar -C "$U/new" -xzf "$U/$f.tar.gz"
    printf '  %s✔%s %s\n' "$G" "$Z" "$f"
  done
  # Guarda os binários de agora: se o novo não subir, volta.
  PREV="$PREFIX/bin/.prev"; rm -rf "$PREV"; mkdir -p "$PREV"
  for b in $BINS; do [ ! -f "$(dest_de "$b")" ] || cp -p "$(dest_de "$b")" "$PREV/$b"; done
  for b in $BINS; do [ ! -f "$U/new/$b" ] || troca "$U/new/$b" "$(dest_de "$b")"; done
  # O próprio setup e o bootstrap: trocados por rename (o setup que roda não muda no lugar).
  [ ! -f "$U/new/setup" ] || { mkdir -p "$PREFIX/libexec"; troca "$U/new/setup" "$PREFIX/libexec/setup"; }
  [ ! -f "$U/new/bootstrap.sh" ] || troca "$U/new/bootstrap.sh" "$PREFIX/bootstrap.sh"
  instala_comando
  # Configuração que versões novas passaram a esperar: só entra o que ainda não existe.
  if [ "$ROLE" = both ] || [ "$ROLE" = controller ]; then
    [ ! -f "$CONF/server-ip" ] || ensure_env "$CONF/controller.env" AI_CLUSTER_ENROLL_ADDR "$(cat "$CONF/server-ip"):$ENROLL_PORT"
  fi
  if [ "$ROLE" = both ] || [ "$ROLE" = gateway ]; then
    gw_ip=$(cat "$CONF/server-ip" 2>/dev/null); [ "$ROLE" = both ] || gw_ip=$(lan_ip)
    [ -z "$gw_ip" ] || ensure_env "$CONF/gateway.env" AI_CLUSTER_GATEWAY_URL "http://$gw_ip:$HTTP_PORT"
  fi
  : > "$SETUP_LOG"; chmod 600 "$SETUP_LOG"
  step "$(t 'Reiniciando os serviços' 'Restarting the services')" reinicia_servicos
  if ! wait_ready >>"$SETUP_LOG" 2>&1; then
    warn "$(t 'a versão nova não subiu; voltando para a anterior' 'the new version did not start; going back to the previous one')"
    for b in $BINS; do [ ! -f "$PREV/$b" ] || troca "$PREV/$b" "$(dest_de "$b")"; done
    reinicia_servicos >>"$SETUP_LOG" 2>&1 || true
    die "$(t "atualização desfeita (log em $SETUP_LOG)" "update rolled back (log in $SETUP_LOG)")"
  fi
  sed -i "s|^VERSION=.*|VERSION=$NEWV|; /^SUMS=/d" "$CONF/release"
  echo "SUMS=$NEWSUM" >> "$CONF/release"
  printf '\n'
  if [ "$LANG_AIC" = en ]; then
    box "Updated to $NEWV" "" \
        "Workers, tokens and certificates were kept." \
        "Workers reconnect on their own in a few seconds." \
        "A new invitation downloads the new worker package." \
        "Previous binaries: $PREV"
  else
    box "Atualizado para $NEWV" "" \
        "Workers, tokens e certificados continuam como estavam." \
        "Os workers se reconectam sozinhos em alguns segundos." \
        "Um novo convite baixa o pacote novo do worker." \
        "Binários anteriores: $PREV"
  fi
  printf '\n'
}

# ---------- despacho: <substantivo> <verbo> ----------
sub_controller() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    install) cmd_controller_install "$@" ;;
    status) need_root; mostra_estado controller ai-cluster-controller "$DATA/state/controller.pid" "$GRPC_PORT" "$ENROLL_PORT" ;;
    logs) need_root; mostra_logs ai-cluster-controller "$LOGDIR/controller.log" "$@" ;;
    *) usage ;;
  esac
}

sub_gateway() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    install) cmd_gateway_install "$@" ;;
    status) need_root; mostra_estado gateway ai-cluster-gateway "$DATA/state/gateway.pid" "$HTTP_PORT" ;;
    logs) need_root; mostra_logs ai-cluster-gateway "$LOGDIR/gateway.log" "$@" ;;
    *) usage ;;
  esac
}

sub_worker() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    join) cmd_worker_join "$@" ;;
    status) need_root; mostra_estado worker ai-cluster-worker "$PREFIX/state/worker.pid" ;;
    logs) need_root; mostra_logs ai-cluster-worker "$PREFIX/state/worker.log" "$@" ;;
    role|change|passwd) worker_so ;;
    *) usage ;;
  esac
}

sub_cluster() {
  verbo=${1:-}; [ $# -eq 0 ] || shift
  case "$verbo" in
    invite) cmd_invite "$@" ;;
    *) usage ;;
  esac
}

case "${1:-}" in
  controller) shift; sub_controller "$@" ;;
  gateway) shift; sub_gateway "$@" ;;
  worker) shift; sub_worker "$@" ;;
  cluster) shift; sub_cluster "$@" ;;
  update) shift; cmd_update "$@" ;;
  *) usage ;;
esac
