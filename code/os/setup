  rm -f /etc/ai-cluster/rpc-tls/worker.crt
  case "\$code" in
    403) m="código do convite errado" ;;
    409) m="este nome já recebeu certificado neste convite (abra outro com sudo aic cluster invite)" ;;
    429) m="convite travado por tentativas erradas (abra outro com sudo aic cluster invite)" ;;
    000) m="sem resposta de $IP:$PORT" ;;
    *) m="HTTP \$code" ;;
  esac
  echo "o servidor não assinou o certificado do nó: \$m" >&2; exit 1
