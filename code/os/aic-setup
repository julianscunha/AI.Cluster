#!/bin/sh
# AI Cluster — gerenciador do cluster neste Linux. Quem costuma chamá-lo é o install.sh, que baixa
# da última release só o que o papel precisa; ele também roda direto, com o pacote ao lado:
#
#   sudo ./aic-setup server  [--role both|controller] [--ip 192.168.1.10] [--models-dir DIR] [--yes]
#   sudo ./aic-setup gateway --server IP[:8099] [--models-dir DIR] [--yes]   # gateway noutro computador
#   sudo ./aic-setup worker  --server IP[:8099] [--yes]                      # entra como worker
#   sudo aic-setup invite    [--minutes 15] [--port 8099]
#   aic-setup status
#
# `server` instala o controller (e, com --role both, o gateway) neste Linux (systemd, ou segundo
# plano se não houver), gera tokens, a CA do túnel RPC e os certificados, e deixa o `ai-cluster`
# pronto. `invite` abre uma janela curta em que outros computadores entram no cluster:
#     curl -fsSL http://<ip>:8099/join | sudo sh          # worker (x86_64 ou armv7)
# e aprova sozinho os nós que entram enquanto o convite está aberto. O pacote do worker de cada
# processador vem da release do servidor (a mesma versão do cluster) e fica em cache.
#
# Ao lado deste script: ai-cluster-controller e ai-cluster (controller), ai-cluster-gateway e
# llama-server (gateway) e bootstrap.sh. O worker e o ggml-rpc-server não vêm: o convite os busca.
set -eu

PREFIX=/opt/ai-cluster
CONF=/etc/ai-cluster
DATA=/var/lib/ai-cluster
LOGDIR=/var/log/ai-cluster
SETUP_LOG=/var/log/ai-cluster-setup.log
GRPC_PORT=50051
HTTP_PORT=8080
HERE=$(cd "$(dirname "$0")" && pwd)

# ---------- apresentação ----------
if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
  B=$(printf '\033[1m'); D=$(printf '\033[2m'); G=$(printf '\033[32m'); R=$(printf '\033[31m')
  C=$(printf '\033[36m'); Y=$(printf '\033[33m'); Z=$(printf '\033[0m'); TTY=1
else
  B=""; D=""; G=""; R=""; C=""; Y=""; Z=""; TTY=0
fi

banner() {
  printf '\n%s  AI Cluster%s  %s%s%s\n' "$B$C" "$Z" "$D" "$1" "$Z"
  printf '  %s────────────────────────────────────────────────────────%s\n\n' "$D" "$Z"
}
die() { printf '\n  %s✘ %s%s\n\n' "$R" "$1" "$Z" >&2; exit 1; }
note() { printf '  %s%s%s\n' "$D" "$1" "$Z"; }
warn() { printf '  %s! %s%s\n' "$Y" "$1" "$Z"; }

TOTAL=0; N=0
# Roda uma função mostrando "n/total descrição"; a saída vai ao log, e o fim dele aparece se falhar.
step() {
  N=$((N + 1)); desc=$1; shift
  if [ "$TTY" = 1 ]; then printf '  %s[%d/%d]%s %s…' "$D" "$N" "$TOTAL" "$Z" "$desc"; fi
  # Subshell com set -e: dentro de `if` o set -e seria ignorado e só o último comando contaria.
  set +e; ( set -e; "$@" ) >>"$SETUP_LOG" 2>&1; rc=$?; set -e
  if [ "$rc" = 0 ]; then
    if [ "$TTY" = 1 ]; then printf '\r\033[K'; fi
    printf '  %s✔%s %s%s%s\n' "$G" "$Z" "$desc" "$D" "" ; printf '%s' "$Z"
  else
    if [ "$TTY" = 1 ]; then printf '\r\033[K'; fi
    printf '  %s✘ %s%s\n' "$R" "$desc" "$Z"
    tail -n 12 "$SETUP_LOG" | sed 's/^/      /' >&2
    die "falhou (log completo em $SETUP_LOG)"
  fi
}

# Largura em caracteres (não em bytes): descarta os bytes de continuação do UTF-8.
clen() { printf '%s' "$1" | LC_ALL=C sed 's/[-¿]//g' | wc -c | tr -d ' '; }
box() { # box linha...
  w=0
  for l in "$@"; do n=$(clen "$l"); [ "$n" -gt "$w" ] && w=$n; done
  line=$(printf '%*s' $((w + 2)) '' | sed 's/ /─/g')
  printf '  %s┌%s┐%s
' "$C" "$line" "$Z"
  for l in "$@"; do
    pad=$(printf '%*s' $((w - $(clen "$l"))) '')
    printf '  %s│%s %s%s %s│%s
' "$C" "$Z" "$l" "$pad" "$C" "$Z"
  done
  printf '  %s└%s┘%s
' "$C" "$line" "$Z"
}

# ---------- utilidades ----------
rand() { head -c 24 /dev/urandom | od -An -tx1 | tr -d ' \n'; }
have_systemd() { [ -d /run/systemd/system ]; }
need_root() { [ "$(id -u)" = 0 ] || die "rode como root: sudo $0 $*"; }
lan_ip() {
  ip route get 1.1.1.1 2>/dev/null | sed -n 's/.* src \([0-9.]*\).*/\1/p' | head -n 1
}
get() { sed -n "s/^$2=//p" "$1" | head -n 1; }   # get <arquivo-env> <CHAVE>

# ---------- servidor ----------
check_system() {
  [ "$(uname -s)" = Linux ] || { echo "só Linux"; return 1; }
  case "$(uname -m)" in
    x86_64) ;;
    armv7l|armv7) [ "$ROLE" = controller ] || { echo "o gateway (llama-server) só existe para x86_64; neste processador instale só o controller"; return 1; } ;;
    *) echo "processador sem pacote: $(uname -m)"; return 1 ;;
  esac
  need="bootstrap.sh"
  case "$ROLE" in
    both) need="$need ai-cluster-controller ai-cluster ai-cluster-gateway llama-server" ;;
    controller) need="$need ai-cluster-controller ai-cluster" ;;
    gateway) need="ai-cluster-gateway llama-server" ;;
  esac
  for b in $need; do
    [ -f "$HERE/$b" ] || { echo "falta $b ao lado do aic-setup"; return 1; }
  done
  [ "$ROLE" = gateway ] || command -v openssl >/dev/null || { echo "precisa do openssl (apt install openssl)"; return 1; }
  case "$ROLE" in both|gateway)
    ldconfig -p 2>/dev/null | grep -q libgomp.so.1 || { echo "precisa do libgomp1 (apt install libgomp1)"; return 1; } ;;
  esac
}

install_files() {
  id ai-cluster >/dev/null 2>&1 || useradd --system --no-create-home --home-dir "$DATA" \
    --shell /usr/sbin/nologin ai-cluster
  mkdir -p "$PREFIX/bin" "$CONF/pki" "$DATA/state" "$MODELS" "$LOGDIR" "$PREFIX/kit"
  for b in ai-cluster-controller ai-cluster-gateway ai-cluster llama-server; do
    [ ! -f "$HERE/$b" ] || install -m 755 "$HERE/$b" "$PREFIX/bin/$b"
  done
  [ ! -f "$HERE/bootstrap.sh" ] || install -m 755 "$HERE/bootstrap.sh" "$PREFIX/bootstrap.sh"
  install -m 755 "$HERE/aic-setup" "$PREFIX/aic-setup" 2>/dev/null || install -m 755 "$0" "$PREFIX/aic-setup"
  ln -sf "$PREFIX/aic-setup" /usr/local/bin/aic-setup
  chown -R ai-cluster:ai-cluster "$DATA" "$LOGDIR"
  [ "$MODELS" = "$DATA/models" ] || chown ai-cluster:ai-cluster "$MODELS"
  chmod 755 "$MODELS"
}

make_credentials() {
  umask 077
  JOIN=$(rand); OPERATOR=$(rand); INFERENCE=$(rand); API_KEY="aic_$(rand)"
  {
    echo "AI_CLUSTER_JOIN_TOKEN=$JOIN"
    echo "AI_CLUSTER_OPERATOR_TOKEN=$OPERATOR"
    echo "AI_CLUSTER_INFERENCE_TOKEN=$INFERENCE"
    echo "AI_CLUSTER_INSECURE=1"
    echo "AI_CLUSTER_NODES=$DATA/state/nodes"
    echo "AI_CLUSTER_STATE=$DATA/state/state.bin"
    echo "AI_CLUSTER_EVENTS=$DATA/state/events.log"
    echo "AI_CLUSTER_MODELS_DIR=$MODELS"
    echo "AI_CLUSTER_MODELS_STATE=$DATA/state/models.state"
  } > "$CONF/controller.env"
  {
    echo "AI_CLUSTER_INFERENCE_TOKEN=$INFERENCE"
    echo "AI_CLUSTER_API_KEY=$API_KEY"
    echo "AI_CLUSTER_INSECURE=1"
    echo "AI_CLUSTER_CONTROLLER=http://127.0.0.1:$GRPC_PORT"
    echo "AI_CLUSTER_GATEWAY_ADDR=0.0.0.0:$HTTP_PORT"
    echo "AI_CLUSTER_MODELS_DIR=$MODELS"
    echo "AI_CLUSTER_LLAMA_SERVER_BIN=$PREFIX/bin/llama-server"
    echo "AI_CLUSTER_LLAMA_TLS_CA=$CONF/pki/ca.crt"
    echo "AI_CLUSTER_LLAMA_TLS_CERT=$CONF/pki/gateway.crt"
    echo "AI_CLUSTER_LLAMA_TLS_KEY=$CONF/pki/gateway.key"
    echo "AI_CLUSTER_LLAMA_CTX=2048"
    echo "AI_CLUSTER_LLAMA_SLOTS=1"
  } > "$CONF/gateway.env"
  {
    echo "AI_CLUSTER_CONTROLLER=http://127.0.0.1:$GRPC_PORT"
    echo "AI_CLUSTER_OPERATOR_TOKEN=$OPERATOR"
    echo "AI_CLUSTER_INSECURE=1"
  } > "$CONF/cli.env"
  echo "$IP" > "$CONF/server-ip"
  chown root:ai-cluster "$CONF/controller.env" "$CONF/gateway.env"
  chmod 640 "$CONF/controller.env" "$CONF/gateway.env"
  chmod 600 "$CONF/cli.env"
  # O comando `ai-cluster` lê o ambiente de cli.env: quem usa não exporta nada.
  cat > /usr/local/bin/ai-cluster <<EOF
#!/bin/sh
[ -r $CONF/cli.env ] || { echo "ai-cluster: sem acesso a $CONF/cli.env (use sudo)" >&2; exit 1; }
set -a; . $CONF/cli.env; set +a
exec $PREFIX/bin/ai-cluster "\$@"
EOF
  chmod 755 /usr/local/bin/ai-cluster
}

make_pki() {
  umask 077
  cd "$CONF/pki"
  # CA própria, que só assina o gateway e os workers deste cluster.
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout ca.key -out ca.crt \
    -subj "/CN=ai-cluster-ca" -days 3650 -addext "basicConstraints=critical,CA:TRUE" \
    -addext "keyUsage=critical,keyCertSign,cRLSign"
  for pair in worker:aic-worker gateway:aic-gateway; do
    name=${pair%%:*}; san=${pair#*:}
    openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout "$name.key" \
      -out "$name.csr" -subj "/CN=$name"
    printf 'subjectAltName=DNS:%s\nbasicConstraints=CA:FALSE\n' "$san" > "$name.ext"
    openssl x509 -req -in "$name.csr" -CA ca.crt -CAkey ca.key -CAcreateserial -out "$name.crt" \
      -days 825 -extfile "$name.ext"
    rm -f "$name.csr" "$name.ext"
  done
  # O gateway (usuário ai-cluster) lê a própria chave; a CA e a chave do worker só o root.
  chown ai-cluster:ai-cluster gateway.key gateway.crt ca.crt
  chown root:ai-cluster "$CONF" "$CONF/pki"; chmod 750 "$CONF" "$CONF/pki"
  chmod 644 ca.crt gateway.crt worker.crt; chmod 600 ca.key worker.key gateway.key
}

write_units() {
  if have_systemd; then
    for svc in $SERVICES; do
      after="network-online.target"
      [ "$svc" = gateway ] && [ "$ROLE" = both ] && after="network-online.target ai-cluster-controller.service"
      cat > "/etc/systemd/system/ai-cluster-$svc.service" <<UNIT
[Unit]
Description=AI Cluster $svc
After=$after
Wants=network-online.target

[Service]
User=ai-cluster
EnvironmentFile=$CONF/$svc.env
ExecStart=$PREFIX/bin/ai-cluster-$svc
Restart=always
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=$DATA $LOGDIR $MODELS

[Install]
WantedBy=multi-user.target
UNIT
    done
    systemctl daemon-reload
  fi
}

svc_start() { # svc_start controller|gateway
  svc=$1
  if have_systemd; then
    systemctl enable "ai-cluster-$svc" >/dev/null 2>&1
    systemctl restart "ai-cluster-$svc"
  else
    pidf="$DATA/state/$svc.pid"
    [ -f "$pidf" ] && kill "$(cat "$pidf")" 2>/dev/null || true
    set --
    while IFS= read -r l; do set -- "$@" "$l"; done < "$CONF/$svc.env"
    su -s /bin/sh ai-cluster -c 'pidf=$1; bin=$2; log=$3; shift 3; \
      setsid env "$@" "$bin" >> "$log" 2>&1 < /dev/null & echo $! > "$pidf"' \
      sh "$pidf" "$PREFIX/bin/ai-cluster-$svc" "$LOGDIR/$svc.log" "$@"
  fi
}

wait_ready() {
  i=0
  if [ "$ROLE" != gateway ]; then
    until /usr/local/bin/ai-cluster nodes >/dev/null 2>&1; do
      i=$((i + 1)); [ $i -gt 30 ] && { echo "o controller não respondeu em 30 s"; return 1; }
      sleep 1
    done
  fi
  i=0
  case "$ROLE" in both|gateway)
    until ss -ltn 2>/dev/null | grep -q ":$HTTP_PORT "; do
      i=$((i + 1)); [ $i -gt 30 ] && { echo "o gateway não respondeu em 30 s"; return 1; }
      sleep 1
    done ;;
  esac
}

# Guarda de onde veio esta versão: o convite busca daí o pacote do worker de cada processador.
save_release() {
  {
    echo "BASE=${AIC_RELEASE_BASE:-}"
    echo "VERSION=${AIC_RELEASE_VERSION:-}"
    echo "ROLE=$ROLE"
    echo "KIND=${AIC_HW_KIND:-}"
  } > "$CONF/release"
  chmod 644 "$CONF/release"
}

cmd_server() {
  MODELS=$DATA/models; IP=""; YES=0; ROLE=both
  while [ $# -gt 0 ]; do
    case "$1" in
      --ip) [ $# -ge 2 ] || die "--ip pede um valor"; IP=$2; shift 2 ;;
      --models-dir) [ $# -ge 2 ] || die "--models-dir pede um valor"; MODELS=$2; shift 2 ;;
      --role) [ $# -ge 2 ] || die "--role pede um valor"; ROLE=$2; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      *) die "argumento desconhecido: $1" ;;
    esac
  done
  case "$ROLE" in both|controller) ;; *) die "--role deve ser both ou controller" ;; esac
  need_root server
  [ -n "$IP" ] || IP=$(lan_ip)
  [ -n "$IP" ] || die "não achei o IP da rede; informe com --ip"
  case "$IP$MODELS" in *[!A-Za-z0-9._/-]*) die "--ip e --models-dir só aceitam letras, dígitos e . _ / -" ;; esac
  case "$MODELS" in /home*) die "--models-dir em /home fica inacessível ao serviço (ProtectHome); use outro caminho" ;; /|/etc*|/usr*|/bin*|/sbin*|/lib*|/boot*|/proc*|/sys*|/dev*|*..*) die "--models-dir não pode ser um diretório do sistema nem conter .." ;; /*) ;; *) die "--models-dir deve ser um caminho absoluto" ;; esac
  banner "Instalação do servidor"
  [ ! -f "$CONF/.installed" ] || die "já instalado. Para um novo convite: sudo aic-setup invite"
  if [ "$ROLE" = both ]; then SERVICES="controller gateway"; WHAT="Controller + gateway"; TOTAL=8
  else SERVICES=controller; WHAT="Controller"; TOTAL=6; fi
  note "$WHAT serão instalados neste computador ($IP)."
  note "Modelos GGUF: $MODELS"
  printf '\n'
  if [ "$YES" != 1 ] && [ -t 0 ]; then
    printf '  Continuar? [S/n] '; read -r a || a=n
    case "$a" in n|N|nao|não) die "cancelado" ;; esac
    printf '\n'
  fi
  : > "$SETUP_LOG"; chmod 600 "$SETUP_LOG"
  step "Verificando o sistema" check_system
  step "Instalando os programas" install_files
  step "Gerando credenciais e o comando ai-cluster" make_credentials
  step "Criando a CA e os certificados do túnel RPC" make_pki
  step "Configurando os serviços" write_units
  step "Subindo o controller" svc_start controller
  if [ "$ROLE" = both ]; then
    sleep 2
    step "Subindo o gateway" svc_start gateway
  fi
  step "Verificando que respondem" wait_ready
  save_release
  touch "$CONF/.installed"
  printf '\n'
  if [ "$ROLE" = both ]; then
    box "Servidor pronto" "" \
        "API (gateway)   http://$IP:$HTTP_PORT/v1/chat/completions" \
        "Controller      http://$IP:$GRPC_PORT" \
        "Modelos         $MODELS" \
        "Administrar     ai-cluster nodes | model list | model start" \
        "Credenciais     $CONF  (somente root)"
  else
    box "Controller pronto" "" \
        "Controller      http://$IP:$GRPC_PORT" \
        "Modelos         $MODELS" \
        "Administrar     ai-cluster nodes | model list" \
        "Credenciais     $CONF  (somente root)"
  fi
  printf '\n  %sPróximos passos%s\n' "$B" "$Z"
  printf '   1. Convide cada outro computador:  %ssudo aic-setup invite%s\n' "$C" "$Z"
  printf '   2. Copie um modelo .gguf para %s\n' "$MODELS"
  [ "$ROLE" != both ] || printf '   3. Carregue:                      %sai-cluster model start <arquivo.gguf>%s\n' "$C" "$Z"
  printf '\n'
}

# ---------- gateway noutro computador ----------
fetch_gateway_kit() {
  t=$(mktemp -d)
  curl -fsS "http://$SERVER/gw-$CODE.tar.gz" -o "$t/k.tgz" \
    || { echo "o convite em $SERVER não respondeu; rode 'sudo aic-setup invite' no controller"; rm -rf "$t"; return 1; }
  tar -C "$t" --no-same-owner -xzf "$t/k.tgz"
  # O env vira EnvironmentFile do serviço: só entram chaves AI_CLUSTER_* com valores simples.
  if grep -qvE '^AI_CLUSTER_[A-Z_]+=[A-Za-z0-9._:/@-]*$' "$t/gateway.env"; then
    echo "gateway.env recebido tem linhas inesperadas; recusado"; rm -rf "$t"; return 1
  fi
  cp "$t/ca.crt" "$t/gateway.crt" "$t/gateway.key" "$CONF/pki/"
  cp "$t/gateway.env" "$CONF/gateway.env"
  sed -i "s#^AI_CLUSTER_MODELS_DIR=.*#AI_CLUSTER_MODELS_DIR=$MODELS#" "$CONF/gateway.env"
  rm -rf "$t"
  chown ai-cluster:ai-cluster "$CONF/pki/gateway.key" "$CONF/pki/gateway.crt" "$CONF/pki/ca.crt"
  chown root:ai-cluster "$CONF" "$CONF/pki"; chmod 750 "$CONF" "$CONF/pki"
  chmod 644 "$CONF/pki/ca.crt" "$CONF/pki/gateway.crt"; chmod 600 "$CONF/pki/gateway.key"
  chown root:ai-cluster "$CONF/gateway.env"; chmod 640 "$CONF/gateway.env"
}

server_arg() { # normaliza IP -> IP:8099
  case "$1" in *:*) printf '%s' "$1" ;; *) printf '%s:8099' "$1" ;; esac
}

cmd_gateway() {
  MODELS=$DATA/models; SERVER=""; CODE=""; YES=0; ROLE=gateway; SERVICES=gateway; TOTAL=6
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) [ $# -ge 2 ] || die "--server pede um valor"; SERVER=$2; shift 2 ;;
      --code) [ $# -ge 2 ] || die "--code pede um valor"; CODE=$2; shift 2 ;;
      --models-dir) [ $# -ge 2 ] || die "--models-dir pede um valor"; MODELS=$2; shift 2 ;;
      --yes|-y) YES=1; shift ;;
      *) die "argumento desconhecido: $1" ;;
    esac
  done
  need_root gateway
  case "$CODE" in ""|*[!A-Za-z0-9]*) die "informe o código do convite: --code (aparece no 'aic-setup invite' do controller)" ;; esac
  [ -n "$SERVER" ] || die "informe o controller: --server IP[:porta do convite]"
  case "$SERVER$MODELS" in *[!A-Za-z0-9._/:-]*) die "--server e --models-dir têm caracteres inválidos" ;; esac
  SERVER=$(server_arg "$SERVER")
  case "$MODELS" in /home*) die "--models-dir em /home fica inacessível ao serviço (ProtectHome)" ;; /*) ;; *) die "--models-dir deve ser um caminho absoluto" ;; esac
  banner "Instalação do gateway"
  [ ! -f "$CONF/.installed" ] || die "já instalado neste computador"
  command -v curl >/dev/null || die "precisa do curl"
  note "O gateway será instalado aqui e ligado ao controller em ${SERVER%%:*}."
  warn "A pasta de modelos ($MODELS) precisa ser a mesma que o controller enxerga (por exemplo, compartilhada por NFS)."
  printf '\n'
  : > "$SETUP_LOG"; chmod 600 "$SETUP_LOG"
  step "Verificando o sistema" check_system
  step "Instalando os programas" install_files
  step "Recebendo as credenciais do controller" fetch_gateway_kit
  step "Configurando o serviço" write_units
  step "Subindo o gateway" svc_start gateway
  step "Verificando que responde" wait_ready
  save_release
  touch "$CONF/.installed"
  printf '\n'
  box "Gateway pronto" "" \
      "API (gateway)   http://$(lan_ip):$HTTP_PORT/v1/chat/completions" \
      "Controller      http://${SERVER%%:*}:$GRPC_PORT" \
      "Modelos         $MODELS"
  printf '\n'
}

# ---------- worker ----------
cmd_worker() {
  SERVER=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --server) [ $# -ge 2 ] || die "--server pede um valor"; SERVER=$2; shift 2 ;;
      --yes|-y) shift ;;
      *) die "argumento desconhecido: $1" ;;
    esac
  done
  need_root worker
  [ -n "$SERVER" ] || die "informe o servidor: --server IP[:porta do convite]"
  case "$SERVER" in *[!A-Za-z0-9.:_-]*) die "--server com caracteres inválidos" ;; esac
  SERVER=$(server_arg "$SERVER")
  banner "Entrar no cluster como worker"
  note "Buscando o pacote do worker em ${SERVER%%:*}…"
  jd=$(mktemp -d)
  curl -fsS "http://$SERVER/join" -o "$jd/join" \
    || { rm -rf "$jd"; die "o convite em $SERVER não respondeu; rode 'sudo aic-setup invite' no servidor"; }
  rc=0; AIC_ARCH="${AIC_HW_ARCH:-}" sh "$jd/join" || rc=$?
  rm -rf "$jd"
  exit $rc
}

# ---------- convite ----------
cmd_invite() {
  MIN=15; PORT=8099
  while [ $# -gt 0 ]; do
    case "$1" in
      --minutes) [ $# -ge 2 ] || die "--minutes pede um valor"; MIN=$2; shift 2 ;;
      --port) [ $# -ge 2 ] || die "--port pede um valor"; PORT=$2; shift 2 ;;
      *) die "argumento desconhecido: $1" ;;
    esac
  done
  need_root invite
  [ -f "$CONF/.installed" ] || die "instale o servidor antes: sudo aic-setup server"
  case "$MIN" in ''|*[!0-9]*) die "--minutes deve ser um número" ;; esac
  case "$PORT" in ''|*[!0-9]*) die "--port deve ser um número" ;; esac
  [ "$MIN" -ge 1 ] || die "--minutes deve ser pelo menos 1"
  command -v python3 >/dev/null || die "precisa do python3 para servir o convite (apt install python3)"
  IP=$(cat "$CONF/server-ip")
  JOIN=$(get "$CONF/controller.env" AI_CLUSTER_JOIN_TOKEN)
  mkdir -p "$PREFIX/kit"
  # O pacote do worker de cada processador vem da release desta versão e fica em cache no servidor.
  AVAILABLE=""
  for a in x86_64 armv7; do
    if fetch_worker_pack "$a"; then AVAILABLE="$AVAILABLE $a"
    else warn "sem pacote de worker para $a (sem internet ou a release não o traz)"; fi
  done
  [ -n "$AVAILABLE" ] || die "nenhum pacote de worker disponível; confira a internet do servidor"
  WEB=$(mktemp -d); GCODE=$(rand | cut -c1-16)
  SUMS=""
  for a in $AVAILABLE; do
    cp "$PREFIX/kit/$(get "$CONF/release" VERSION)-worker-linux-$a.tar.gz" "$WEB/worker-linux-$a.tar.gz"
    SUMS="$SUMS
  $a) SUM=$(sha256sum "$WEB/worker-linux-$a.tar.gz" | cut -d' ' -f1) ;;"
  done
  cp "$PREFIX/bootstrap.sh" "$WEB/bootstrap.sh"
  # Credenciais do túnel RPC dos workers e o kit do gateway (só dentro da janela do convite).
  tar -C "$CONF/pki" -czf "$WEB/pki-worker.tar.gz" ca.crt worker.crt worker.key
  g=$(mktemp -d)
  cp "$CONF/pki/ca.crt" "$CONF/pki/gateway.crt" "$CONF/pki/gateway.key" "$g/"
  sed "s#^AI_CLUSTER_CONTROLLER=.*#AI_CLUSTER_CONTROLLER=http://$IP:$GRPC_PORT#" "$CONF/gateway.env" > "$g/gateway.env"
  tar -C "$g" -czf "$WEB/gw-$GCODE.tar.gz" .
  rm -rf "$g"
  BSUM=$(sha256sum "$WEB/bootstrap.sh" | cut -d' ' -f1); PSUM=$(sha256sum "$WEB/pki-worker.tar.gz" | cut -d' ' -f1)
  # O script que a outra máquina baixa: escolhe o pacote pelo processador, confere e instala.
  cat > "$WEB/join" <<JOIN_SCRIPT
#!/bin/sh
# AI Cluster — entra neste cluster como worker.  Uso: curl -fsSL http://$IP:$PORT/join | sudo sh
set -eu
[ "\$(id -u)" = 0 ] || { echo "rode com sudo: curl -fsSL http://$IP:$PORT/join | sudo sh" >&2; exit 1; }
case "\$(uname -m)" in
  x86_64) A=x86_64 ;; armv7l|armv7) A=armv7 ;;
  *) echo "este computador é \$(uname -m): ainda não há pacote de worker para ele" >&2; exit 1 ;;
esac
[ -z "\${AIC_ARCH:-}" ] || [ "\$AIC_ARCH" = "\$A" ] || { echo "você informou \$AIC_ARCH, mas este computador é \$A" >&2; exit 1; }
case "\$A" in $SUMS
  *) echo "o servidor não tem pacote de worker para \$A" >&2; exit 1 ;;
esac
[ "\$A" != x86_64 ] || ldconfig -p 2>/dev/null | grep -q libgomp.so.1 || echo "aviso: falta libgomp1 (apt install libgomp1)" >&2
T=\$(mktemp -d); trap 'rm -rf "\$T"' EXIT
echo "AI Cluster: baixando o pacote do worker (\$A) de $IP…"
curl -fsS http://$IP:$PORT/worker-linux-\$A.tar.gz -o "\$T/w.tgz"
echo "\$SUM  \$T/w.tgz" | sha256sum -c - >/dev/null || { echo "pacote corrompido ou adulterado" >&2; exit 1; }
mkdir "\$T/w"; tar -C "\$T/w" -xzf "\$T/w.tgz"
curl -fsS http://$IP:$PORT/bootstrap.sh -o "\$T/bootstrap.sh"
curl -fsS http://$IP:$PORT/pki-worker.tar.gz -o "\$T/pki.tgz"
echo "$BSUM  \$T/bootstrap.sh" | sha256sum -c - >/dev/null || { echo "bootstrap.sh adulterado" >&2; exit 1; }
echo "$PSUM  \$T/pki.tgz" | sha256sum -c - >/dev/null || { echo "certificados adulterados" >&2; exit 1; }
id ai-cluster >/dev/null 2>&1 || useradd --system --no-create-home --home-dir /opt/ai-cluster/state --shell /usr/sbin/nologin ai-cluster
mkdir -p /etc/ai-cluster/rpc-tls
tar -C /etc/ai-cluster/rpc-tls --no-same-owner -xzf "\$T/pki.tgz"
chmod 644 /etc/ai-cluster/rpc-tls/ca.crt /etc/ai-cluster/rpc-tls/worker.crt
chown root:ai-cluster /etc/ai-cluster/rpc-tls/worker.key; chmod 640 /etc/ai-cluster/rpc-tls/worker.key
install -m 755 "\$T/w/ggml-rpc-server" /usr/local/bin/ggml-rpc-server
printf '%s\n' "$JOIN" > "\$T/join-token"; chmod 600 "\$T/join-token"
NAME=\$(hostname | sed 's/[^A-Za-z0-9.-]/-/g')
AIC_INVITED=1 sh "\$T/bootstrap.sh" --controller http://$IP:$GRPC_PORT --insecure \
  --join-token-file "\$T/join-token" --binary "\$T/w/ai-cluster-worker" --node-id "\$NAME" \
  --rpc-server-bin /usr/local/bin/ggml-rpc-server --rpc-tls-dir /etc/ai-cluster/rpc-tls </dev/null
echo "Pronto: \$NAME entrou no cluster. O servidor aprova o nó em instantes."
JOIN_SCRIPT
  cd "$WEB"
  # Sem listagem de diretório: o código do gateway não pode ser descoberto olhando a raiz.
  python3 -c 'import http.server, sys
class H(http.server.SimpleHTTPRequestHandler):
    def list_directory(self, path):
        self.send_error(404)
http.server.ThreadingHTTPServer((sys.argv[1], int(sys.argv[2])), H).serve_forever()' "$IP" "$PORT" >/dev/null 2>&1 &
  SRV=$!
  # Qualquer saída (erro, Ctrl+C, fim do prazo) derruba o servidor e apaga o que ele servia.
  trap 'kill "$SRV" 2>/dev/null; rm -rf "$WEB"' EXIT
  trap 'printf "\n  Convite encerrado.\n\n"; exit 0' INT TERM
  sleep 1
  kill -0 "$SRV" 2>/dev/null || die "não consegui abrir a porta $PORT em $IP (em uso?)"
  banner "Convite de computadores"
  box "Worker (qualquer computador x86_64 ou ARM de 32 bits), rode:" "" \
      "curl -fsSL http://$IP:$PORT/join | sudo sh" "" \
      "Gateway noutro computador: sudo aic-setup gateway --server $IP:$PORT --code $GCODE" "" \
      "Válido por $MIN min. Linux com systemd e, no x86_64, libgomp1."
  printf '\n  %sAguardando computadores… (Ctrl+C encerra o convite)%s\n\n' "$D" "$Z"
  END=$(( $(date +%s) + MIN * 60 ))
  while [ "$(date +%s)" -lt "$END" ]; do
    # Nós pendentes enquanto o convite está aberto são aprovados: foi o operador quem os convidou.
    /usr/local/bin/ai-cluster nodes 2>/dev/null | awk '$0 ~ /pendente/ {print $1}' | while read -r n; do
      case "$n" in -*) continue ;; esac
      /usr/local/bin/ai-cluster approve "$n" --trust-listed >/dev/null 2>&1 \
        && printf '  %s✔%s %s entrou e foi aprovado\n' "$G" "$Z" "$n"
      true
    done || true
    sleep 3
  done
  printf '\n  Convite expirou. Para outro: sudo aic-setup invite\n\n'
}

# Baixa o pacote do worker de um processador para o cache, conferindo o SHA-256 da release.
fetch_worker_pack() {
  f="worker-linux-$1.tar.gz"
  [ -f "$CONF/release" ] || return 1
  base=$(get "$CONF/release" BASE)
  dest="$PREFIX/kit/$(get "$CONF/release" VERSION)-$f"   # o cache é por versão
  [ -f "$dest" ] && return 0
  [ -n "$base" ] || return 1
  t=$(mktemp -d)
  curl -fsSL "$base/SHA256SUMS" -o "$t/S" && curl -fsSL "$base/$f" -o "$t/f" || { rm -rf "$t"; return 1; }
  want=$(awk -v f="$f" '$2==f {print $1}' "$t/S"); have=$(sha256sum "$t/f" | cut -d' ' -f1)
  [ -n "$want" ] && [ "$want" = "$have" ] || { rm -rf "$t"; return 1; }
  mv "$t/f" "$dest"; rm -rf "$t"
}

cmd_status() {
  banner "Estado do cluster"
  [ -f "$CONF/cli.env" ] || die "não instalado neste computador"
  /usr/local/bin/ai-cluster nodes 2>&1 | cut -c1-110
  printf '\n'
  /usr/local/bin/ai-cluster model status 2>&1 | head -n 12 || true
}

case "${1:-}" in
  server) shift; cmd_server "$@" ;;
  gateway) shift; cmd_gateway "$@" ;;
  worker) shift; cmd_worker "$@" ;;
  invite) shift; cmd_invite "$@" ;;
  status) shift; cmd_status ;;
  *) echo "uso: aic-setup server|gateway|worker|invite|status  (veja o cabeçalho do script)" >&2; exit 2 ;;
esac
