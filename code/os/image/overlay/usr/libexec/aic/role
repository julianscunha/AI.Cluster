#!/bin/sh
# Diz qual é o papel deste worker no cluster, lendo só a configuração local (sem token e sem rede).
#   aic worker role         resumo em várias linhas
#   aic worker role --short  uma linha, para o console
# Quem aprova o worker é o controller: confira lá com `aic cluster nodes` (coluna CONFIANÇA).

usage() {
	cat <<'USO'
aic worker role - diz o papel deste worker no cluster, lendo so a configuracao local

uso: aic worker role [--short]
  sem argumento   resumo: no, papel, estado do worker, controller, registro, versao e slot
  --short         so o papel, em uma linha (e o que o console mostra)
A estrutura do cluster e a aprovacao dos workers sao do controller: aic cluster topology.
USO
}
case "${1:-}" in -h | --help) usage; exit 0 ;; esac

ENV_FILE=${AIC_WORKER_ENV:-/data/worker.env}
CMDLINE=${AIC_CMDLINE:-/proc/cmdline}

# valor de uma chave do worker.env, sem aspas; o token nunca é lido
value() { sed -n "s/^$1=//p" "$ENV_FILE" 2>/dev/null | head -n 1 | tr -d "\"'" | tr -d '\000-\037\177'; }

node=$(value AI_CLUSTER_NODE_ID)
controller=$(value AI_CLUSTER_CONTROLLER)
model_dir=$(value AI_CLUSTER_MODEL_DIR)
cache_mb=$(value AI_CLUSTER_SHARD_CACHE_MB)
credential=$(value AI_CLUSTER_NODE_CREDENTIAL_FILE)

if grep -q 'aic\.controller=' "$CMDLINE" 2>/dev/null || [ "$(value AI_CLUSTER_PRESENCE_ONLY)" = 1 ]; then
	role="recuperacao (so presenca: registra e responde, nao recebe trabalho)"
else
	role="worker de computacao"
	[ -n "$model_dir" ] && role="$role + fatias de modelo (${cache_mb:-2048} MB)"
fi

if [ "$1" = "--short" ]; then
	echo "$role"
	exit 0
fi

if pidof ai-cluster-worker >/dev/null 2>&1; then state="worker em execucao"; else state="worker parado"; fi
if [ -n "$credential" ] && [ -s "$credential" ]; then joined="sim (credencial salva)"; else joined="ainda nao (sem credencial salva)"; fi

# Cores só num terminal (NO_COLOR desliga); o mesmo desenho do console e do painel do cluster.
. /usr/lib/aic/ui.sh
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then C_RESET= C_LOGO= C_TEXT= C_VALUE= C_OK= C_WARN= C_BAD= C_HINT= C_NODE=; fi
case "$state" in *execucao) sc=$C_OK ;; *) sc=$C_BAD ;; esac
case "$joined" in sim*) jc=$C_OK ;; *) jc=$C_WARN ;; esac
row() { printf '  %s%-12s%s %s%s%s\n' "$C_LOGO" "$1" "$C_RESET" "$3" "$2" "$C_RESET"; } # rótulo valor cor

row 'Worker' "${node:-$(hostname)}" "$C_VALUE"
row 'Papel' "$role" "$C_VALUE"
row 'Estado' "$G_NODE $state" "$sc"
row 'Controller' "${controller:-nao configurado}" "$C_VALUE"
row 'Registrado' "$joined" "$jc"
row 'Versao' "$(cat /etc/aic-release 2>/dev/null || echo dev)   slot $(sed -n 's/.*aic\.slot=\([AB]\).*/\1/p' "$CMDLINE")" "$C_VALUE"
printf '\n  %sA estrutura do cluster e a aprovacao dos workers sao do controller:%s\n' "$C_HINT" "$C_RESET"
printf '  %saic cluster --controller %s topology%s\n' "$C_HINT" "${controller:-URL}" "$C_RESET"
