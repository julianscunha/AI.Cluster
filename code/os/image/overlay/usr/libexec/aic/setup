#!/bin/sh
# AI Cluster OS - o `setup` deste no (ADR-024). Mesmo contrato `<substantivo> <verbo>` do setup dos Linux:
# quem chama e o `aic` (/usr/bin/aic), que repassa a linha. Os programas que ele usa ficam aqui, fora do PATH:
# role (papel), change (troca de controller), passwd (senha do console) e os daemons (aic-updater etc.).
#
#   aic worker status | role [--short] | logs [-f] [-n N] | change ... | passwd [--remove]
#   aic update status | apply
. /usr/lib/aic/ui.sh
DIR=/usr/libexec/aic
VER=$(cat /etc/aic-release 2>/dev/null || echo dev)

usage() {
	echo "uso: aic worker status | role [--short] | logs [-f] [-n N] | change ... | passwd [--remove]" >&2
	echo "     aic update status | apply" >&2
	exit 2
}

# logs: os registros do worker e do tunel do modelo (o mesmo que `aic worker logs`).
mostra_logs() {
	n=50; seg=0
	while [ $# -gt 0 ]; do
		case "$1" in
		-f) seg=1; shift ;;
		-n) [ $# -ge 2 ] || { echo "aic worker logs: -n pede um numero" >&2; exit 2; }
			case "$2" in '' | *[!0-9]*) echo "aic worker logs: -n pede um numero" >&2; exit 2 ;; esac
			n=$2; shift 2 ;;
		*) echo "aic worker logs: opcao desconhecida: $1" >&2; exit 2 ;;
		esac
	done
	[ "$seg" = 1 ] && exec tail -n "$n" -f /var/log/ai-cluster-worker.log
	exec tail -n "$n" /var/log/ai-cluster-worker.log
}

# update status: so le o estado da ultima atualizacao (nada e instalado aqui).
atualizacao_status() {
	slot=$(sed -n 's/.*aic\.slot=\([AB]\).*/\1/p' /proc/cmdline)
	echo "versao $VER  slot ${slot:-?}"
	if [ -r /data/state/update-result ]; then
		echo "ultimo resultado:"
		sed 's/^/  /' /data/state/update-result
	else
		echo "sem registro de atualizacao neste no"
	fi
}

sub=${1:-}; verbo=${2:-}
[ $# -lt 2 ] || shift 2
case "$sub" in
worker)
	case "$verbo" in
	status) banner worker "$VER" "Este computador no cluster"; exec "$DIR/role" ;;
	role) exec "$DIR/role" "$@" ;;
	logs) mostra_logs "$@" ;;
	change) exec "$DIR/change" "$@" ;;
	passwd) exec "$DIR/passwd" "$@" ;;
	*) usage ;;
	esac ;;
update)
	case "$verbo" in
	status) banner atualizacao "$VER" "Versao e ultima atualizacao deste no"; atualizacao_status ;;
	# A atualizacao assinada e empurrada pelo controller (aic cluster rollout); este no nao puxa release.
	apply) banner atualizacao "$VER" "Atualizacao deste no"
		echo "a atualizacao assinada chega pelo controller (aic cluster rollout); este no nao a puxa sozinho." >&2
		echo "o aic-updater aplica a release quando ela chega. Para ver o resultado: aic update status" >&2
		exit 1 ;;
	*) usage ;;
	esac ;;
*) usage ;;
esac
