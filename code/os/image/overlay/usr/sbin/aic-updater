#!/bin/sh
# Aplica a release pedida (F19): confere a assinatura, baixa para /data, confere o SHA-256, grava o
# slot inativo, relê o slot e compara com a medida assinada, marca-o em teste (aic_try) e reinicia.
# A confirmação e o rollback são do u-boot e do aic-slot-commit.
REQ=/data/state/update-request
DL=/data/.update   # só do root: o worker grava em /data/state, não aqui
PUBS=/etc/aic-release.d   # uma ou mais públicas (rotação): vale se qualquer uma confere
. /etc/aic-board   # board=… slot_mib=…
. /usr/lib/aic/ab.sh   # slot_dev, state_get, state_set da plataforma
log() { logger -t aic-updater "$*"; }
# a recusa vai para um arquivo que o worker lê: ele não fica esperando um reinício que não vem
# noclobber (O_EXCL) não segue link simbólico plantado pelo worker no diretório dele
fail() { log "$*"; rm -f /data/state/update-result; ( set -C; umask 022; echo "$*" > /data/state/update-result ) 2>/dev/null; }

safe() { case "$1" in ''|*[!A-Za-z0-9._:/%+=-]*) return 1;; esac; }
hex64() { case "$1" in *[!0-9a-fA-F]*) return 1;; esac; [ ${#1} -eq 64 ]; }

# a < b na ordem de versões (a e b numéricas, separadas por ponto)
older() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | head -n 1)" = "$1" ]; }

apply() {
	# o pedido é escrito pelo worker (sem privilégio): link simbólico não vale
	if [ -L "$REQ" ]; then rm -f "$REQ"; return; fi
	read -r version url sha image_sha signature < "$REQ"
	rm -f "$REQ"
	case "$version" in ''|*[!0-9.]*) fail "versão inválida (só números e pontos)"; return;; esac
	safe "$version" && safe "$url" && safe "$signature" && hex64 "$sha" && hex64 "$image_sha" && [ ${#signature} -eq 88 ] \
		|| { fail "pedido inválido, ignorado"; return; }

	# Assinatura do operador sobre placa, versão e as duas somas (a chave pública é da imagem, somente leitura):
	# nem o controller nem o worker comprometidos escolhem o que vai para o slot.
	# a mensagem e a assinatura ficam num diretório do root (0700), nunca em /tmp
	w=$(mktemp -d /run/aic-upd.XXXXXX) || { fail "sem diretório de trabalho"; return; }
	printf 'aic-release-v1\n%s\n%s\n%s\n%s\n' "$board" "$version" "$sha" "$image_sha" > "$w/msg"
	printf '%s' "$signature" | base64 -d > "$w/sig" 2>/dev/null
	ok=
	for k in "$PUBS"/*.pub; do
		openssl pkeyutl -verify -pubin -inkey "$k" -rawin -in "$w/msg" -sigfile "$w/sig" >/dev/null 2>&1 && { ok=1; break; }
	done
	if [ -z "$ok" ]; then
		fail "assinatura inválida para $board $version; ignorado"; rm -rf "$w"; return
	fi
	rm -rf "$w"
	current=$(cat /etc/aic-release 2>/dev/null)
	case "$current" in ''|*[!0-9.]*) fail "versão instalada ilegível; recuso atualizar"; return;; esac
	if [ "$version" = "$current" ] || older "$version" "$current"; then fail "versão $version não é mais nova que $current; recusada"; return; fi

	# o URL só pode apontar para o host do controller (worker.env é do root)
	controller=$(sed -n 's/^AI_CLUSTER_CONTROLLER=//p' /data/worker.env | head -n 1)
	chost=${controller#*://}; chost=${chost%%[:/]*}
	uhost=${url#*://}; uhost=${uhost%%[:/]*}
	[ -n "$chost" ] && [ "$chost" = "$uhost" ] || { fail "URL fora do host do controller; ignorado"; return; }
	# em boot de teste (aic_try pendente) o slot atual não é o confirmado: gravar no outro destruiria o bom
	if [ -n "$(state_get aic_try)" ]; then fail "slot ainda em teste; atualização adiada"; return; fi
	[ "$(df -k /data | awk 'NR==2 {print $4}')" -gt $((slot_mib * 1400)) ] || { fail "pouco espaço em /data"; return; }
	slot=$(sed -n 's/.*aic\.slot=\([AB]\).*/\1/p' /proc/cmdline)
	case "$slot" in A) target=B;; B) target=A;; *) fail "sem aic.slot; não é uma imagem A/B"; return;; esac
	dev=$(slot_dev "$target") || { fail "sem partição do slot $target"; return; }
	log "baixando $version para o slot $target"
	rm -rf "$DL"; mkdir -m 700 "$DL" || { fail "sem diretório de download"; return; }
	TMP=$DL/update.gz
	wget -q -T 60 -O "$TMP" "$url" || { fail "download falhou"; rm -rf "$DL"; return; }
	echo "$sha  $TMP" | sha256sum -c >/dev/null 2>&1 || { fail "SHA-256 não confere; descartado"; rm -rf "$DL"; return; }
	gunzip -t "$TMP" 2>/dev/null || { fail "gzip corrompido; descartado"; rm -rf "$DL"; return; }
	log "gravando $dev"
	if ! gunzip -c "$TMP" | dd of="$dev" bs=1M conv=fsync 2>/dev/null; then fail "gravação falhou; o slot $target ficou inconsistente mas não é o confirmado"; rm -rf "$DL"; return; fi
	rm -rf "$DL"
	# relê o que ficou no slot: pega gravação ruim com o mesmo código que a mediu
	echo 3 > /proc/sys/vm/drop_caches 2>/dev/null
	written=$(dd if="$dev" bs=1M count="$slot_mib" 2>/dev/null | sha256sum | cut -d' ' -f1)
	[ "$written" = "$image_sha" ] || { fail "o slot $target não confere com a medida assinada; não será usado"; return; }
	# slot atual continua o confirmado; o novo entra em teste com duas tentativas (boot.cmd)
	state_set "$slot" "$target" || { fail "não gravou o estado"; return; }
	log "slot $target em teste; reiniciando"
	sync
	reboot
}

while :; do
	[ -f "$REQ" ] && apply
	sleep 5
done
