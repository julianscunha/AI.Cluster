#!/bin/sh
# Chamado pelo worker (usuário sem privilégio) quando o controller manda uma release (F19): só deixa o
# pedido em /data/state; quem verifica a assinatura e grava o slot é o aic-updater, como root.
[ $# -eq 5 ] || exit 2
umask 077
printf '%s %s %s %s %s\n' "$1" "$2" "$3" "$4" "$5" > /data/state/update-request.tmp && mv /data/state/update-request.tmp /data/state/update-request
