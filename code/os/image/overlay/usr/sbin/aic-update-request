#!/bin/sh
# Chamado pelo worker (usuário sem privilégio) quando o controller manda uma release (F19): só deixa o
# pedido em /data/state; quem grava o slot é o aic-updater, que roda como root e revalida tudo.
[ $# -eq 3 ] || exit 2
umask 077
printf '%s %s %s\n' "$1" "$2" "$3" > /data/state/update-request.tmp && mv /data/state/update-request.tmp /data/state/update-request
