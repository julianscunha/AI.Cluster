#!/bin/sh
# Boas-vindas do login por SSH: o cabeçalho do componente (o mesmo do `aic`) e o resumo do nó.
. /usr/lib/aic/ui.sh
if [ ! -t 1 ] || [ -n "${NO_COLOR:-}" ]; then C_RESET= C_HINT= C_TEXT=; fi
banner worker "$(cat /etc/aic-release 2>/dev/null || echo dev)" "Este computador no cluster"
/usr/libexec/aic/role
printf '\n  %sComandos: aic worker status | aic worker logs | aic worker passwd | aic --help%s\n\n' "$C_HINT" "$C_RESET"
