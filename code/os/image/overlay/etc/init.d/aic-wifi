#!/sbin/openrc-run
# Vigia de rede (ADR-030): sobe o Wi-Fi quando ha credencial em /data/wifi e retoma o cabo quando volta.
name="aic-wifi"
description="Wi-Fi com cabo preferencial (netwatch)"
command=/usr/libexec/aic/netwatch
command_background=true
pidfile=/run/aic-wifi.pid

depend() {
	need net localmount
	before aic-dns
}

# o netwatch deixa wpa_supplicant e udhcpc do wlan0 vivos; para so os dois, pelo pidfile (nunca o eth0).
# Espera o processo sair: um restart logo depois não pode achar o wlan0 ainda em uso.
stop_post() {
	for p in /run/udhcpc.wlan0.pid /run/wpa_supplicant.wlan0.pid; do
		if [ -s "$p" ]; then
			pid=$(cat "$p")
			kill "$pid" 2>/dev/null
			i=0; while kill -0 "$pid" 2>/dev/null && [ $i -lt 50 ]; do sleep 0.1; i=$((i+1)); done
		fi
		rm -f "$p"
	done
}
