#!/sbin/openrc-run
# Serviço do worker (F15). A identidade do nó mora em /data/worker.env, escrito pelo instalador.
name="ai-cluster-worker"
description="AI Cluster worker"
command="/usr/bin/ai-cluster-worker"
command_user="ai-cluster:ai-cluster"
supervisor="supervise-daemon"
respawn_delay=3
directory="/data/state"
output_log="/var/log/ai-cluster-worker.log"
error_log="/var/log/ai-cluster-worker.log"

depend() {
	need net localmount
	after chronyd
}

start_pre() {
	if [ ! -r /data/worker.env ]; then
		eerror "falta /data/worker.env (controller, token, id do nó)"
		return 1
	fi
	set -a
	. /data/worker.env
	set +a
	# rpc-server do llama.cpp (ADR-022): liga sozinho quando o instalador deixou o certificado do túnel
	# em /data/rpc-tls (worker.crt, worker.key e ca.crt, a CA que assina só o gateway). Sem eles o nó
	# não expõe o rpc-server.
	if [ -r /data/rpc-tls/worker.key ] && [ -r /data/rpc-tls/worker.crt ] && [ -r /data/rpc-tls/ca.crt ] && [ -x /usr/bin/ggml-rpc-server ]; then
		export AI_CLUSTER_RPC_SERVER_BIN=/usr/bin/ggml-rpc-server
		export AI_CLUSTER_RPC_TLS_CERT=/data/rpc-tls/worker.crt
		export AI_CLUSTER_RPC_TLS_KEY=/data/rpc-tls/worker.key
		export AI_CLUSTER_RPC_TLS_CLIENT_CA=/data/rpc-tls/ca.crt
		export AI_CLUSTER_RPC_VERSION="${AI_CLUSTER_RPC_VERSION:-llama.cpp-8ca4060+armv7}"
		# Cache de tensores do rpc-server em disco real (o /tmp é RAM); o worker o liga sozinho se o
		# disco lê bem mais rápido que o enlace.
		export AI_CLUSTER_RPC_CACHE_DIR="${AI_CLUSTER_RPC_CACHE_DIR:-/data/cache}"
	fi
	[ -n "$AI_CLUSTER_NODE_ID" ] && hostname "$AI_CLUSTER_NODE_ID"
	checkpath -d -o ai-cluster:ai-cluster -m 0700 /data/state
	[ -z "$AI_CLUSTER_RPC_CACHE_DIR" ] || checkpath -d -o ai-cluster:ai-cluster -m 0700 "$AI_CLUSTER_RPC_CACHE_DIR"
}
