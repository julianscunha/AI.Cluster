auto lo
iface lo inet loopback

auto eth0
iface eth0 inet dhcp

# Wi-Fi (ADR-030): sem `auto`; o aic-wifi (netwatch) o sobe quando ha /data/wifi/wpa_supplicant.conf.
# Metrica maior que a do cabo: com os dois no ar o cabo leva a rota padrao; sem ele, o Wi-Fi.
iface wlan0 inet dhcp
	wpa-conf /data/wifi/wpa_supplicant.conf
	metric 200
